.ml-5level {
  @apply ml-5;
}

.radio-group {
  @apply mt-4;
  display: flex;
  flex-direction: column;
  gap: 8px; /* Optional: Adjust gap between items */
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 4px; /* Optional: Adjust space between radio button and label */
}

.agency__flex-1 > div {
  @apply mb-8;
}

.telepondiv {
  @apply mt-[179px];
}

.alamatdiv {
  @apply w-full mb-8;
}

.alamatdiv {
  @apply mb-8;
  & textarea {
    @apply w-full h-24 p-3;
  }
}

.passpordiv {
  @apply mt-[203px];
}

.upload-container {
}
.thumbnail-wrapper {
  @apply flex items-start;
}
.thumbnail-wrapper img {
  @apply sm:mr-[50px] mr-[20px];
}
.thumbnail-wrapper button {
  @apply h-[40px] w-[100px] bg-axa-grey-400 text-axa-grey-800 uppercase cursor-pointer flex items-center text-xs font-semibold justify-center p-[5px] border-[1px] border-solid border-black;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.thumbnail-wrapper button {
  @apply mt-[5px] hover:bg-axa-blue-300 hover:text-white;
}

/* .thumbnail {
  @apply min-w-[220px] h-[130px] w-[220px] mb-[10px] rounded-lg sm:min-w-[160px] sm:h-[90px];
}
*/
.thumbnail {
  @apply min-w-[160px] h-[90px] w-[160px] mb-[10px] rounded-lg sm:min-w-[220px] sm:h-[130px];
}



