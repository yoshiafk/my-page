/* update */
.ml-2level {
  @apply ml-2;
}

.input-control-axa-tahun {
  @apply border p-2;
  padding-right: 40px;
}

.checkbox-container {
  background-color: white;
  cursor: pointer;
}

.checkbox-container.checked {
  background-color: #003865; /* AXA Blue 900 */
}

.checkbox-container.checked svg {
  display: block;
}

.input-group-axa__custome {
  position: relative;
}

.font_tahun {
  @apply text-[#757575] font-semibold pr-[12px] absolute right-2 flex items-center;
  top: 50%;
  transform: translateY(-50%);
}


.pb-2level {
  @apply pb-2;
}

.mt-150px {
	@apply mt-[150px];
}

.mt-152px {
	@apply mt-[152px];
}

