/* COMPONENTS */
.hero {
  @apply bg-white pt-[65px] md:pt-0;
  & .hero__home {
    @apply pt-[60px] lg:pt-0 xl:pt-0;
    & h1 {
      @apply max-w-full lg:max-w-full xl:max-w-full leading-tight text-[32px] lg:text-[48px] xl:text-[48px] mb-4;
    }
    & p {
      @apply text-[16px] lg:text-[20px] xl:text-[20px] text-[#757575] font-semibold;
    }
    & .style-img {
      @apply h-[155px] md:h-[250px] lg:h-[350px] xl:h-[472px] 2xl:h-[600px] !bg-cover !bg-center;
    }
    & .hero__home--grid {
      @apply grid grid-cols-1 lg:grid-cols-2 lg:gap-16 h-full;
      & img {
        @apply w-full h-full object-cover;
      }
      & .col {
        @apply last:self-center last:py-12 last:px-[20px] first:order-2 lg:first:order-1 lg:last:order-1;
      }
    }
    & .card-hero {
      @apply max-w-[380px] border border-[#EEEEEE] px-8 py-6 mt-8;
    }
    & .card-hero_sa {
      @apply max-w-[558px] border border-[#EEEEEE] px-8 py-6 mt-8;
    }
    & .card-header-hero {
      & h3 {
        @apply font-publico text-axa-bluesky-900 text-[26px] mb-3;
      }
    }
    & .card-body-hero {
      & p {
        @apply text-[16px] font-normal mb-3;
      }
      & a {
        @apply text-[#D75D3D] text-[18px] underline hover:no-underline block mb-3;
      }
    }
    & .card-footer-hero {
      & .card-footer-hero__flex {
        @apply flex justify-between;
        & .card-footer-hero__right {
          & .btn {
            @apply font-semibold p-[12px_25px_12px_25px] tracking-normal;
          }
          & i {
            @apply ml-2;
          }
        }
      }
      & p {
        @apply font-normal text-[14px] text-axa-bluesky-900;
      }
      & .price {
        & span {
          @apply font-bold text-[24px] mt-1 mb-[1px] leading-none text-[#3A5E94];
        }
      }
      & small {
        @apply text-[13px] text-axa-grey-800;
      }
    }
  }
}
& .hero-mobile {
  @apply pt-0;
  & .hero-mobile__home {
    @apply pt-0;
  }
}
& .brand-logo {
  @apply relative z-10;
}
.navbar-axa-wrapper {
  @apply bg-white w-full fixed lg:static z-[1030];
  & .navbar-axa {
    @apply w-full bg-white;
  }
  & .navbar-axa__inner {
    @apply flex h-16 items-center justify-between;
  }
  & .btn-responsive-wrapper {
    @apply p-[22px] pr-2 sm:block md:block lg:hidden cursor-pointer;
    & button {
      @apply relative inline-flex items-center justify-center rounded-md p-2;
      & .abs-inset {
        @apply absolute -inset-0.5;
      }
      & .svg-block {
        @apply block h-6 w-6;
      }
      & .svg-hidden {
        @apply hidden h-6 w-6;
      }
    }
  }
  & .brand-logo-wrapper {
    @apply flex flex-shrink-0 items-center;
  }
  & .nav-axa-wrapper {
    @apply flex flex-1 items-center justify-center sm:items-stretch sm:justify-end;
    & .nav-axa {
      @apply hidden sm:ml-6 sm:hidden md:hidden lg:block xl:block;
      & .nav-axa__inner {
        @apply flex md:space-x-2 lg:space-x-3 xl:space-x-4;
        & a {
          @apply uppercase hover:text-white p-[8px_18px_7px_18px] rounded-[50px] hover:bg-axa-ocean-200;
          transition: 0.4s all;
        }
      }
    }
  }
  & .nav-axa__mega-menu {
    @apply self-center p-[20px_0px];
    & .nav-axa__mega-menu--hover {
      @apply absolute bg-axa-ocean-200 text-white left-0 top-[117px] w-full invisible opacity-0 pointer-events-none;
      transition: 0.1s all;
      &.is-open-mega-menu {
        @apply visible opacity-100;
      }
      & .container-axa {
        @apply h-full pr-[40px];
      }
    }
    & span {
      @apply uppercase p-[8px_18px_7px_18px] cursor-pointer rounded-[50px] hover:bg-axa-ocean-200 hover:text-white;
      transition: 0.4s all;
    }
    &.is-active {
      & span {
        @apply bg-axa-ocean-200 text-white;
      }
    }
    &:hover {
      & .nav-axa__mega-menu--hover {
        @apply visible opacity-100 pointer-events-auto;
      }
    }
  }
}
.cloak {
  @apply absolute w-[28%] 2xl:w-[35%] h-[62px] bg-transparent;
}
.nav-axa__mega-menu-content {
  @apply h-full grid grid-cols-[1fr_2fr] gap-10;
  & span {
    @apply !p-0;
  }
  & h3 {
    @apply font-publico text-[30px] mb-2;
  }
  & .border-separate {
    @apply pt-[45px] pr-[58px] pb-[4rem] mt-[25px] mb-[25px] relative before:absolute before:right-0 before:bg-white before:bg-opacity-25 before:w-[1px] before:h-full before:top-0;
  }
  & span {
    @apply text-[13px] tracking-[1.3px] uppercase block mb-3 font-semibold;
  }
  & a {
    @apply !p-0 !normal-case;
  }
  & ul {
    & li {
      @apply relative mb-3;
      & a {
        @apply block;
        & i {
          @apply text-[12px] absolute top-[7px] right-20;
        }
      }
    }
  }
  & .col-grid {
    @apply grid grid-cols-[1fr_2fr] pb-[2rem] mt-[30px] gap-4;
    & .card-mega-menu {
      @apply hidden;
      & figcaption {
        @apply mt-2;
      }
      &.is-show {
        @apply block;
      }
      & .card-mega-menu-inner {
        @apply grid grid-cols-2 gap-6;
      }
    }
  }
}
#mobile-menu {
  @apply sm:block md:block;
  & ul {
    @apply pt-[5px];
    & li {
      @apply border-b border-[#EEEEEE] last:border-none;
      & a {
        @apply block p-[8px_15px_8px_15px] hover:text-axa-ocean-200;
        transition: 0.4s all;
        &.is-active-link {
          @apply bg-transparent text-axa-ocean-100;
          & .span-wrapper {
            @apply bg-axa-ocean-100;
          }
        }
      }
      & .sub-menu {
        @apply bg-axa-ocean-200 w-full h-full absolute top-0 -right-full;
        transition: 0.4s all;
        &.is-active {
          @apply right-0;
        }
        & p,
        h3 {
          @apply text-white;
        }
        & h3 {
          @apply text-[32px] font-publico font-bold;
        }
        & a {
          @apply text-white flex justify-between;
          & i {
            @apply text-[14px] self-center;
          }
        }
        & ul {
          & li {
            @apply text-white border-none first:uppercase first:font-semibold first:tracking-[1.3px] first:pl-[0px] first:text-[16px] first:mb-2;
            & a {
              @apply p-[8px_20px_8px_0px];
            }
          }
        }
      }
      &:first-child {
        & a {
          @apply flex justify-between;
          & i {
            @apply text-[14px] self-center;
          }
        }
      }
      & p {
        @apply mb-3;
      }
      & .back-sub-menu {
        @apply mt-4 mb-2;
        & a {
          @apply p-0;
          & i {
            @apply text-[24px];
          }
        }
      }
    }
    & a.is-active-link:hover {
      @apply text-white;
    }
    & a.is-active-link:hover svg path {
      @apply stroke-white;
    }
  }
}
#mobile-menu {
  @apply bg-white w-full fixed h-full top-[64px] left-[100%] z-[1020];
  transition: 0.4s all;
  &.is-show {
    @apply lg:hidden;
  }
  &.is-show {
    @apply left-[0%];
  }
}

@media only screen and (min-width: 320px) {
  #navbar ul {
    max-height: 390px;
  }
}

@media only screen and (min-width: 375px) {
  #navbar ul {
    max-height: 380px;
  }
}

@media only screen and (min-width: 390px) {
  #navbar ul {
    max-height: 560px;
  }
}

@media only screen and (min-width: 393px) {
  #navbar ul {
    max-height: 480px;
  }
}

@media only screen and (min-width: 414px) {
  #navbar ul {
    max-height: 450px;
  }
}

@media only screen and (min-width: 768px) {
  #navbar ul {
    max-height: 100%;
  }
}

@media (max-width: 768px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.08);
  }
}
@media (min-width: 600px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}
@media (min-width: 900px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}
@media (min-width: 992px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}
@media (min-width: 1024px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, 0);
  }
}
@media (min-width: 1200px) {
  .navbar-axa-wrapper {
    box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, 0);
  }
}
@media (max-width: 768px) {
  .navbar-text-wrapper {
    display: none;
  }
}
.table-wrapper {
  @apply max-w-full mx-auto overflow-x-auto;
}
.container-axa {
  @apply container mx-auto px-2 xl:px-[30px] 2xl:px-[15px];
}
label {
  @apply font-semibold mb-3;
}
.input-control-axa {
  @apply p-[14px] w-full rounded-none text-[#757575] uppercase outline-none placeholder:font-normal placeholder:text-[#bababa] placeholder:normal-case;
  &.input-control-axa--outline {
    @apply border border-[#EEEEEE];
  }
  &:disabled {
    @apply bg-[#dddddd] cursor-not-allowed;
  }
}
.btn {
  @apply text-white text-[14px] uppercase tracking-[1px] p-[16px_10px_15px_10px] xl:p-[16px_15px_15px_18px] border-transparent transition-[0.4s] inline-block align-middle;
  &.btn--dark-blue {
    @apply bg-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-blue-100 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }
  &.btn--dark-blue-outline {
    @apply text-axa-blue-400 bg-white border border-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-blue-300 before:duration-300 before:ease-out hover:text-white hover:before:h-40 hover:before:w-full hover:before:opacity-100;
  }
  &.btn--sienna {
    @apply bg-axa-sienna-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-sienna-200 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }
  &.btn--white {
    @apply bg-white text-[#343C3D] relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-sienna-400 before:duration-300 before:ease-out hover:text-white hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }
}
/* & .disabled {
    @apply !bg-[#CCCCCC] !cursor-no-drop pointer-events-none;
    & svg {
      & path {
        @apply !stroke-gray-400;
      }
    }
    &:hover {
      @apply !bg-[#CCCCCC] !border-[#CCCCCC];
      &:before {
        @apply !bg-[#7a7a7a];
      }
    }
  } */
.tab-content > .tab-pane {
  @apply hidden;
}
.tab-content > .active {
  @apply block;
}

.checkbox-custom-label span,
.radio-custom-label span {
  @apply ml-[5px] font-normal;
}
.checkbox-custom-wrapper input,
.form-check input {
  @apply p-0 w-[initial] h-[initial] mb-0 hidden cursor-pointer;
}
.checkbox-custom-wrapper span,
.radio-custom-wrapper span {
  @apply cursor-pointer;
}
.checkbox-custom-wrapper label,
.form-check label {
  @apply relative cursor-pointer;
}
.checkbox-custom-wrapper label:before,
.form-check label:before {
  content: "";
  appearance: none;
  background-color: #fff;
  border: 1px solid #00006d;
  padding: 6px;
  display: inline-block;
  position: relative;
  vertical-align: middle;
  cursor: pointer;
  margin-right: 5px;
}
.form-check label:before {
  margin-right: 10px;
}
.checkbox-custom-wrapper input:checked + label:before,
.form-check input:checked + label:before {
  background-color: #00006d;
}
.checkbox-custom-wrapper input:checked + label:after,
.form-check input:checked + label:after {
  content: "";
  display: block;
  position: absolute;
  top: 5px;
  left: 5px;
  width: 4px;
  height: 8px;
  border: solid #fff;
  border-width: 0 1.8px 1.8px 0;
  transform: rotate(45deg);
}
.form-check input:checked + label:after {
  border-width: 0 1.9px 1.9px 0;
  top: 8px;
}
.radio-custom-wrapper {
  position: relative;
}
.radio-custom-wrapper input {
  @apply p-0 w-[initial] h-[initial] mb-0 hidden cursor-pointer;
}
.radio-custom-wrapper label:before {
  content: "";
  appearance: none;
  background-color: #fff;
  border: 1px solid #cccccc;
  border-radius: 50%;
  padding: 9px;
  display: inline-block;
  position: relative;
  vertical-align: middle;
  cursor: pointer;
  margin-right: 5px;
}
.radio-custom-wrapper input:checked + label:before {
  background-color: #fff;
  border: 1px solid #00008f;
}
.radio-custom-wrapper input:checked + label:after {
  content: "";
  display: block;
  background-color: #00008f;
  position: absolute;
  border-radius: 50%;
  top: 5px;
  left: 4px;
  width: 12px;
  height: 12px;
  transform: rotate(45deg);
}
.radio-custom-wrapper input:checked + label:after {
  top: 7px;
}

.modal-axa-smarttravel {
  @apply p-[1rem] !important;
}
.modal-axa-smarttravel {
  @apply fixed outline-none z-[1055] top-2/4 left-2/4 translate-y-[-50%] translate-x-[-50%];
  & h1,
  & h3 {
    @apply font-sourcesans font-semibold;
  }
  & .modal-axa-smarttravel-dialog {
    @apply mx-auto relative;
  }
  & .modal-axa-smarttravel-content {
    @apply bg-white w-full h-full;
  }
  & .modal-axa-smarttravel-header {
    @apply px-6 py-4 border-b border-axa-grey-200;
    & .btn-close {
      @apply absolute right-0 top-0 m-[25px];
      & i {
        @apply text-[#1F1F9C] transition-all hover:text-axa-sienna-400 text-[26px];
      }
    }
    & h1 {
      @apply text-[30px];
    }
  }
  & .modal-axa-smarttravel-body {
    @apply px-6 pt-6 pb-8;
    & h3 {
      @apply text-axa-bluesky-900 mb-2 text-[24px];
    }
    & p {
      @apply text-[#999999];
    }
  }
  & .modal-axa-smarttravel-footer {
    @apply flex justify-between border-axa-grey-300 border-t mt-12;
  }
  &.fade {
    & .modal-axa-smarttravel-dialog {
      transition: transform 0.3s ease-out;
      transform: translate(0, -50px);
    }
  }
  &.show {
    & .modal-axa-smarttravel-dialog {
      transform: none;
    }
  }
}

.modal-lg {
  @apply w-full lg:max-w-[800px];
}

.btn-no {
  @apply text-axa-blue-400 hover:text-axa-sienna-400 hover:underline;
  transition: 0.4s all;
}

.fade {
  transition: opacity 0.15s linear;
}
.fade:not(.show) {
  opacity: 0;
}
.modal-backdrop {
  @apply fixed w-[100vw] h-full bg-black/40 top-0 left-0 z-[1050] backdrop-blur;
  &.fade {
    @apply opacity-0;
  }
  &.show {
    @apply opacity-[1];
  }
}
.modal-axa-smarttravel {
  @apply w-full h-full overflow-x-hidden overflow-y-auto;
}
.modal-axa-smarttravel-dialog-centered {
  display: flex;
  align-items: center;
  min-height: calc(100% - 0px * 2);
}

/* add edit  */
.benefit_type {
  @apply mt-4;
  & .benefit_type__title {
    @apply text-axa-blue-300 text-[16px] font-bold;
  }
}

.benefit_type__title {
  margin-bottom: 0; /* Remove any bottom margin from the title */
}

.benefit_type__item {
  margin-top: 0; /* Remove any top margin from the ul parent */
}

.agency__text_axa_bluesky_900 {
  @apply text-axa-bluesky-900;
}

.info-link {
  display: inline-block;
  width: 16px;
  height: 16px;
  margin-left: 6px;
  background-color: #d75d3d; /* axa siena */
  color: #fff;
  text-align: center;
  line-height: 16px;
  border-radius: 50%;
  font-weight: normal;
  text-decoration: none;
  font-size: 12px; /* Make the question mark smaller */
}

.mt-30px {
  @apply mt-[30px];
}

.calendar-wrapper {
  & .daterangepicker {
    @apply w-[305px];
  }
}

.navbar-text-wrapper {
  & .item {
    & .top {
      @apply text-[#404040];
    }
    & .btm {
      @apply font-semibold text-axa-blue-400;
      & a {
        @apply text-black ml-2;
      }
    }
  }
}

.nav-summary {
  @apply bg-axa-blue-500 py-6;
  & .nav-summary__inner {
    @apply flex justify-between flex-col lg:flex-row;
  }
  & ul {
    @apply first:text-[#FAFAFA] first:text-[24px] first:mb-4 lg:first:mb-0 last:flex last:justify-between last:gap-8;
    &:last-child {
      @apply self-center;
      & a {
        @apply relative text-[14px] md:text-[16px] text-white hover:text-axa-grey-400 hover:!font-normal hover:no-underline pl-6 underline;
        transition: 0.4s all;
        margin-right: 0;

        &:before,
        &:after {
          content: "";
          width: 14px;
          height: 14px;
          position: absolute;
          left: 0;
          top: 4px;
          transition: 0.4s all;
          filter: brightness(0) invert(1);
        }

        &:before {
          @apply bg-[url('../../../images/icon_download.svg')] bg-no-repeat bg-contain;
        }

        &:after {
          @apply bg-[url('../../../images/icon_download_hover.svg')] bg-no-repeat bg-contain opacity-0 invisible;
        }

        &:hover {
          @apply font-bold;
        }
      }
    }
  }
}

.sticky-aside {
  @apply sticky top-8 xl:block;
  & .sticky-aside-nav {
    @apply pl-4 pb-3 border-b border-b-axa-blue-400 hidden xl:block;
    & li {
      @apply pl-4 mb-3 relative before:w-[16px] before:h-[16px] before:bg-[#D9D9D9] before:absolute before:left-[-16px] before:top-[5px];
      &:before {
        transition: 0.4s all;
      }
      & a {
        @apply text-[18px] block font-semibold;
      }
      & span {
        & a {
          @apply font-normal pt-3 pl-8 pb-2;
        }
      }
    }
  }
  & .aside-link-pane {
    &.is-active,
    &:hover {
      @apply before:bg-axa-sienna-400;
      & a {
        @apply text-axa-sienna-400;
      }
    }
  }
  & .download-tab {
    @apply mt-6 mb-10 xl:mb-0 xl:block;
    & li {
      @apply mb-4;
    }
    & a {
      @apply relative text-[18px] text-axa-blue-400 font-semibold hover:text-axa-sienna-400 pl-8;
      transition: 0.4s all;
      &:before,
      &:after {
        content: "";
        width: 20px;
        height: 20px;
        position: absolute;
        left: 0px;
        transition: 0.4s all;
      }
      &:before {
        @apply bg-[url('../../../images/icon_download.svg')] bg-no-repeat bg-contain;
      }
      &:after {
        @apply bg-[url('../../../images/icon_download_hover.svg')] bg-no-repeat bg-contain opacity-0 invisible;
      }
      & span {
        @apply relative;
        &:first-child {
          @apply w-[20px];
        }
        &:last-child {
          @apply w-[200px];
        }
      }
      &:hover {
        &:before {
          @apply invisible opacity-0;
        }
        &:after {
          @apply visible opacity-100;
        }
      }
    }
  }
}

.radio-wrapper {
  @apply inline-block;
  & .sa-radio-custom-wrapper {
    @apply first:mb-2 first:mt-4;
  }
}
