/*html,
  body {
    @apply font-sourcesans font-normal;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    @apply bg-[#FAFAFA];
  }*/

h1,
h2,
strong {
  @apply text-axa-bluesky-900 font-bold font-publico;
}

.topbar {
  @apply bg-axa-grey-200 py-2 hidden lg:block xl:block;
  & .topbar__nav {
    @apply flex gap-6;
    & .fas {
      @apply text-sm mr-2;
    }
    & li {
      @apply self-center;
    }
    & .topbar-link {
      @apply hover:text-axa-ocean-200;
      transition: 0.4s all;
    }
    & .btn {
      @apply rounded-[60px] tracking-[2px] p-[8px_22px_8px_22px] self-center;
    }
  }
}
#hamburger {
  @apply relative outline-none shadow-none focus:outline-none;
  & span {
    @apply bg-axa-blue-400 w-[28px] h-[3px] absolute right-0;
    transition: 0.4s all;
  }
  & span:nth-child(1) {
    @apply top-[-12px];
  }
  & span:nth-child(2) {
    @apply top-[-4px];
  }
  & span:nth-child(3) {
    @apply top-[4px] visible;
    transition: 0.4s all;
    opacity: 1;
  }
  &.is-anime {
    & span:nth-child(1) {
      transform: rotate(45deg);
      top: -4px;
    }
    & span:nth-child(2) {
      top: -4px;
      transform: rotate(-45deg);
    }
    & span:nth-child(3) {
      @apply invisible opacity-0;
      transform: rotate(45deg);
      top: -4px;
    }
  }
}
.brand-logo {
  @apply h-[35px];
}

.form-radio {
  @apply relative;
}

.form-radio input[type="radio"] {
  opacity: 0;
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: 2;
  cursor: pointer;
}

.box-radio-wrapper .box-radio {
  background: #fff;
  border: 1px solid #e5e5e5;
  width: 100%;
  min-height: 125px;
  position: relative;
  padding: 0 10px;
}

.form-radio img {
  width: 100px;
  height: 125px;
  max-width: 100%;
  margin: 0 auto;
  display: block;
  object-fit: cover;
}

.box-radio-wrapper .box-text {
  font-size: 16px;
  font-weight: 600;
  color: #757575;
  margin: 8px 0 10px;
  display: block;
}

.form-radio input[type="radio"]:checked + .box-radio-wrapper .box-radio {
  border: 1px solid #3033c1;
}

.form-radio input[type="radio"]:checked + .box-radio-wrapper .box-text {
  color: #3033c1;
}

.btn-date,
.btn-apply {
  padding: 8px 16px;
  font-size: 12px;
  text-transform: uppercase;
}

.btn-apply {
  @apply bg-axa-blue-400 text-white !important;
}
.input-icon-date {
  @apply md:bg-[url('../../../images/icon_calendar.svg')] md:bg-no-repeat md:bg-[length:22px] md:bg-[right_15px_center];
}

.simulasi {
  @apply mb-6;
  & h1 {
    @apply text-[35px] mt-10 mb-6;
  }
  & .simulasi__inner {
    @apply bg-white border border-[#EEEEEE] lg:grid lg:grid-cols-[1fr_1.8fr] px-3 lg:gap-8 lg:px-8 xl:px-10  pt-[25px] pb-[25px] lg:pt-[40px] lg:pb-[40px];
    & label {
      @apply text-[#757575];
    }
    & .input-control-axa {
      @apply text-axa-blue-300;
    }
    & .grid-radio {
      @apply grid grid-cols-2 lg:grid-cols-[20%_20%];
    }
    & .calendar-wrapper {
      @apply grid grid-cols-2;
      & .daterangepicker {
        @apply w-[260px];
      }
      & .drp-calendar {
        &.left {
          @apply mr-0 p-[8px_0px_8px_0px] lg:p-[8px_0px_8px_18px];
        }
      }
      & #Fromtravel-wrapper {
        & input {
          @apply p-[14px_25px_14px_55px];
          border-right: none;
        }
        & .label-text {
          @apply left-[14px] translate-x-[2px] translate-y-[-50%];
        }
      }
      & #Totravel-wrapper {
        & .daterangepicker {
          @apply !left-[10%] lg:!left-0 -translate-x-1/2 lg:-translate-x-0;
        }
        & input {
          @apply p-[14px_25px_14px_50px];
          border-left: none;
        }
        & .label-text {
          @apply left-[14px] translate-x-[10px] translate-y-[-50%];
        }
      }
      & .label-text {
        @apply text-[#111B1D80] absolute;
        top: 50%;
      }
      & .separated-arrow {
        @apply absolute left-1/2 top-1/2 -translate-x-[188%] -translate-y-1/2 z-10;
      }
    }
    & .form-radio-wrapper {
      @apply grid grid-cols-2 lg:grid-cols-[130px_130px_130px] gap-3;
    }
    & .simulasi__inner--right {
      & .select2-container--default {
        & .select2-selection--single {
          border: none;
        }
      }
      & .input-grid {
        @apply grid grid-cols-1 lg:grid-cols-2 gap-4;
      }
      & .select-input-wrapper {
        @apply max-w-[530px];
      }
      & .select-adult-wrapper,
      & .select-kid-wrapper {
        @apply w-full;
      }
      & .grid-bottom {
        @apply grid grid-cols-1 lg:grid-cols-[3fr_1fr] gap-8;
        & .btn {
          & i {
            @apply ml-2;
          }
        }
      }
      & p {
        @apply text-[#757575] text-[14px];
      }
    }
  }
}

.chosee-plan {
  @apply mb-16;
  & h1 {
    @apply text-[30px] mb-4;
  }
  & .swiper-plan {
    @apply pb-[10px];
  }
  & .swiper-slide {
    @apply h-auto w-[90%] md:w-[60%] lg:w-[40%] min-[1200px]:w-[40%] xl:w-[35%] min-[1400px]:w-[38%] 2xl:w-2/6;
  }
  & .card-plan-wrapper {
    & .card-plan {
      @apply bg-white h-full p-[8px] lg:p-[8px] xl:p-[15px_15px_15px_15px] bg-clip-content border border-transparent overflow-hidden;
      display: flex;
      flex-direction: column;
      transition: 0.4s all;
      & .card-label {
        @apply bg-[#FFBC11] text-[#3A5E94] text-[12px] leading-none p-[6px_10px_8px_15px] inline-block;
        & i {
          @apply text-[18px] ml-1 relative top-[1px];
        }
        &.minimum {
          @apply bg-axa-blue-400 text-white p-[15px_15px_12px_15px];
        }
      }
      & .card-plan-body {
        @apply relative z-10 p-[20px_20px_10px_20px];
        flex: 1 1 auto;
      }
      & strong {
        @apply text-[22px] xl:text-[30px];
      }
      & h3 {
        @apply text-[25px] xl:text-[32px] font-semibold text-[#3A5E94] leading-none mt-3 mb-1;
      }
      & p {
        @apply text-[#7698CB] text-[17px];
      }
      & ul {
        @apply text-[#757575] text-[16px] pl-4 mt-4 tracking-[1px];
        & li {
          @apply mb-1 last:mb-0;
          & span {
            @apply block;
          }
          & strong {
            @apply text-[14px] text-[#343C3D] font-semibold font-sourcesans;
          }
        }
      }
      & .btn-buy {
        @apply mt-2 mb-3;
        & .btn {
          @apply text-[14px] min-w-[165px];
          & i {
            @apply ml-1;
          }
        }
      }
      & .link-comparison {
        & a {
          @apply text-[14px] text-axa-sienna-300 underline hover:no-underline hover:text-axa-blue-300;
        }
      }
      & .card-plan-footer {
        @apply pb-6 mt-[20px];
        & svg {
          @apply mr-1;
        }
      }
      &.optimal-chosee,
      &:hover {
        @apply border-axa-blue-300;
      }
    }
  }
  & .card-plan-wrapper {
    @apply h-full;
    & .card-plan__inner {
      @apply h-full;
    }
  }
  & .chosee-plan__tabs {
    @apply mt-10;
    &.step {
      @apply mt-0 lg:mt-10;
      & h1 {
        @apply mt-6;
      }
    }
    & .nav-tabs {
      @apply grid grid-rows-1 grid-flow-col border-y border-y-[#E5E5E5];
      & li {
        & button {
          @apply bg-transparent w-full md:w-full lg:w-full text-[18px] text-center block py-5 relative before:w-full before:h-[0px] before:bg-axa-blue-400 before:absolute before:bottom-0 before:left-1/2 before:-translate-x-1/2 before:opacity-0 before:invisible;
          transition: 0.2s all;
          &.active,
          &:hover {
            @apply bg-white font-bold text-axa-blue-400 before:h-[6px] before:opacity-100 before:visible;
          }
        }
      }
    }
    & .tab-content {
      @apply mt-6 xl:mt-12;
      & .tab-content__inner {
        @apply block xl:flex xl:flex-row xl:gap-20;
        & .col-tab {
          @apply w-full xl:w-[20%] xl:last:w-[80%];
        }
      }
      & .sticky-tab-pane {
        @apply sticky top-8 xl:block;
      }
      & #select-anchor-wrapper {
        @apply mb-6 xl:hidden;
        & .select2-results__option--selectable {
          @apply normal-case;
        }
        &
          .select2-container--default
          .select2-selection--single
          .select2-selection__rendered {
          @apply font-bold text-axa-blue-400;
        }
      }
      & h1 {
        @apply text-[30px] xl:text-[35px] text-center xl:text-left leading-none mb-8 xl:mb-10;
      }
      & h2 {
        @apply text-[20px] xl:text-[25px] text-center xl:text-left leading-none mb-4 xl:mb-6;
      }
      & h3 {
        @apply text-[15px] xl:text-[20px] text-center xl:text-left leading-none mb-4 xl:mb-6;
      }
      & .sitemap-tabs {
        @apply pl-4 pb-3 border-b border-b-axa-blue-400 hidden xl:block;
        & li {
          @apply pl-4 mb-3 relative before:w-[16px] before:h-[16px] before:bg-[#D9D9D9] before:absolute before:left-[-16px] before:top-[5px];
          &:before {
            transition: 0.4s all;
          }
          & a {
            @apply text-[18px] block font-semibold;
          }
          & span {
            & a {
              @apply font-normal pt-3 pl-8 pb-2;
            }
          }
        }
      }
      & .tab-link-pane {
        &.is-active,
        &:hover {
          @apply before:bg-axa-sienna-400;
          & a {
            @apply text-axa-sienna-400;
          }
        }
      }
      & .download-tab {
        @apply mt-6 mb-10 xl:mb-0 xl:block;
        & li {
          @apply mb-4;
        }
        & a {
          @apply relative text-[18px] text-axa-blue-400 font-semibold hover:text-axa-sienna-400 pl-8;
          transition: 0.4s all;
          &:before,
          &:after {
            content: "";
            width: 20px;
            height: 20px;
            position: absolute;
            left: 0px;
            transition: 0.4s all;
          }
          &:before {
            @apply bg-[url('../../../images/icon_download.svg')] bg-no-repeat bg-contain;
          }
          &:after {
            @apply bg-[url('../../../images/icon_download_hover.svg')] bg-no-repeat bg-contain opacity-0 invisible;
          }
          & span {
            @apply relative;
            &:first-child {
              @apply w-[20px];
            }
            &:last-child {
              @apply w-[200px];
            }
          }

          &:hover {
            &:before {
              @apply invisible opacity-0;
            }
            &:after {
              @apply visible opacity-100;
            }
          }
        }
      }
      & .smart-mediacare-inter__product {
        @apply mb-10;
        & .display-flex-responsive {
          @apply block xl:flex;
        }
        & strong {
          @apply text-[22px] mb-2 block;
        }
        & img {
          @apply w-[200px] xl:w-[450px] m-[0px_auto_30px_auto] xl:m-[0px_auto_0px_auto];
        }
      }
      & .smart-mediacare-inter__benefit {
        @apply mb-14;
        & .icon {
          @apply w-[85px] h-[85px] inline-block;
          &.guard-24 {
            @apply bg-[url('../../../images/icon_sun-cream.svg')] bg-no-repeat bg-contain;
          }
        }
        & .card-benefit-wrapper {
          @apply max-w-[884px] grid grid-cols-1 md:grid-cols-3 xl:grid-cols-[repeat(4,minmax(250px,1fr))] gap-5;
          & .card-benefit {
            @apply bg-white py-9 px-6;
            & img {
              @apply w-[100px] h-[100px] mx-auto block;
            }
            & h3 {
              @apply text-[20px] text-[#1F1F9C] font-semibold mt-6 mb-2;
            }
            & p {
              @apply text-[14px] text-[#757575];
            }
          }
        }
      }
      & .smart-mediacare-inter__table {
        @apply mb-14;
        & .panel-table {
          @apply bg-white border border-[#EEEEEE] mb-4;
          & .panel-table-header {
            @apply border-b border-[#EEEEEE] py-5 px-5;
            & h4 {
              @apply text-[26px] text-axa-bluesky-900 font-semibold;
            }
          }
          & .panel-table-body {
            @apply p-2 lg:p-5;
          }
        }
        & table.table-axa {
          @apply w-full table table-auto lg:table-auto xl:table-fixed;
          &.table-w-auto {
            @apply table-auto;
          }
          & thead {
            & tr {
              & td {
                @apply font-bold uppercase text-axa-blue-400 tracking-[1px] p-4;
                &:nth-child(1) {
                  @apply bg-white sticky left-0;
                }
              }
            }
          }
          & tbody {
            & tr {
              & td {
                @apply text-[#4976BA] py-2 px-4 tracking-[1.2px] first:tracking-normal normal-case;
                &:nth-child(1) {
                  @apply bg-white text-[#343C3D] sticky left-0 whitespace-normal normal-case;
                }
              }
            }
          }
        }
      }
      & .smart-mediacare-inter__faq {
        @apply mb-8;
        & h1 {
          @apply mb-8;
        }
        & p,
        & ul {
          @apply text-[#343C3D];
        }
        & ul {
          @apply list-disc pl-4;
          & li {
            @apply pl-0;
          }
        }
      }
      & .smart-mediacare-inter__download {
        & h1 {
          @apply mb-6;
        }
        & .icon {
          @apply w-[40px] h-[40px] inline-block;
          &.file-pdf {
            @apply bg-[url('../../../images/icon_pdf.png')] bg-no-repeat bg-contain bg-center;
          }
        }
        & table.table-axa {
          @apply bg-white w-full table-auto xl:table-fixed;
          & tbody {
            & tr {
              @apply border-y border-y-[#CCCCCC];
              &:last-child {
                @apply border-y border-y-transparent;
              }
            }
            & td {
              @apply text-black px-6 py-4;
              & .btn {
                @apply w-[125px] m-[0_0_0_auto];
              }
              &:nth-child(1) {
                @apply w-[90px];
              }
              &:nth-child(3) {
                @apply text-[#757575] text-right;
              }
            }
          }
        }
      }
    }
  }
}
.accordion {
  & .collapsing {
    height: 0;
    transition: height 0.35s ease;
    overflow: hidden;
  }
  & .collapse:not(.show) {
    display: none;
  }
  & .collapse {
    visibility: visible;
  }
}
.accordion-button {
  @apply bg-[#3A5E94] text-[13px] tracking-[1px] text-white w-full text-left px-10 py-6 relative uppercase font-bold;
  transition: 0.4s all;
  overflow-anchor: none;
  cursor: pointer;
  & .fa-chevron-down {
    transition: transform 0.4s ease-in-out;
    backface-visibility: hidden;
    transform: rotate(0deg);
  }
  &[aria-expanded="true"] {
    & .fa-chevron-down {
      transform: rotate(180deg);
    }
  }
}
.accordion-body {
  @apply bg-[#EAF0FA] p-[35px_40px];
  & p {
    @apply text-[15px];
  }
  & ul {
    & li {
      @apply border-t border-axa-grey-300 pl-[25px];
    }
  }
}
.sticky-plan {
  @apply bg-white sticky bottom-0 z-50;
  box-shadow: 0px -5px 12px 0px #0000000d;
  transition: 0.4s all;
  &.is-active {
    @apply bottom-0;
  }
  & .trigger-collapse-promo {
    &.is-active {
      & .fa-chevron-right {
        &:before {
          content: "\f00d";
          font-size: 20px;
        }
      }
    }
  }
  & .code-promo,
  & .detail-summary {
    @apply bg-[#D0EAFF];
    & .code-promo__inner,
    & .detail-summary__inner {
      @apply flex justify-between;
    }
    & a {
      @apply text-[#336D9E] font-semibold uppercase py-4 block;
      & i {
        @apply self-center;
      }
    }
  }
  & .detail-summary {
    @apply hidden opacity-0 invisible;
    &.is-active {
      @apply block opacity-100 visible;
    }
    & .fa-times {
      &:before {
        font-size: 20px;
      }
    }
  }
  & .collapse-promo {
    @apply bg-white w-full z-50;
    transition: 0.4s all;
    & .input-group-axa {
      & button {
        @apply bg-white p-[12px];
      }
    }
    & .form__inner {
      @apply grid grid-cols-1 lg:grid-cols-[6.1fr_1fr] gap-4;
      & input {
        @apply w-full block;
      }
      & .btn {
        @apply w-full lg:w-auto p-[17px_15px_16px_18px];
      }
    }
    &.is-active {
      @apply visible h-full;
      transition: 0.4s all;
      & .container-axa {
        @apply opacity-100;
      }
    }
  }
  & .collapse-plan-detail {
    @apply pt-[10px] pb-[15px] w-full h-0 absolute invisible z-50 lg:hidden;
    &.is-active {
      @apply visible h-full;
      transition: 0.4s all;
      & .container-axa {
        @apply opacity-100;
      }
    }
    & label {
      @apply relative;
      &:before {
        @apply text-[#3A5E94] absolute right-2 top-[5px] -translate-y-1/2;
        font-family: "Font Awesome 5 Pro";
        font-weight: 900;
        content: "\f0d7";
      }
    }
    & select {
      @apply relative w-full bg-transparent appearance-none border-b-[2px] border-b-axa-blue-400 outline-none font-bold font-publico text-axa-bluesky-900 text-[40px] mb-3;
    }
    & p {
      @apply text-[20px];
    }
    & ul {
      @apply mt-[2px];
      & li {
        @apply text-[#343C3D] grid grid-cols-2 mb-2;
        &:nth-child(3) {
          @apply mb-[8px];
        }
        &:nth-child(1),
        &:nth-child(2),
        &:nth-child(3) {
          & span {
            &:nth-child(1) {
              @apply pl-6;
            }
          }
        }

        & span {
          @apply text-[16px] last:text-[#7698CB];
        }
        & strong {
          @apply block;
        }
      }
    }
    & .total-premi {
      & strong {
        @apply font-sourcesans font-semibold;
      }
      & small {
        @apply text-[14px];
      }
      & .discount {
        @apply line-through;
      }
      & .total-result {
        @apply text-[24px] leading-[12px] mt-2 mb-3;
      }
    }
  }
  & .collapsing {
    height: 0;
    overflow: hidden;
    transition: height 0.35s ease;
  }
  & .container-axa {
    @apply xl:px-6;
  }
  & .sticky-plan__inner {
    @apply min-h-[116px];
    transition: 0.2s all;
    &.is-active {
      @apply min-h-[240px] xl:min-h-[168px];
    }
    &.is-active-detail {
      @apply min-h-[490px] xl:min-h-[223px];
    }
    &.is-active-desc {
      @apply min-h-[450px] lg:min-h-full;
      transition: 0.4s all;
      & .plan-view-detail {
        @apply block lg:hidden;
      }
    }
  }
  & .sticky-plan-desc__inner {
    @apply py-4 grid grid-cols-[1fr_1fr] xl:grid-cols-[3fr_1fr_1fr];
    transition: 0.2s all;
    &.is-hide {
      @apply opacity-0 invisible lg:visible lg:opacity-100;
    }
    & .cat-plan {
      @apply flex gap-3;
    }
    & .type-insurance {
      @apply text-[24px] max-w-[245px] leading-snug;
    }
    & .type-plan {
      @apply text-[#343C3D] underline font-sourcesans text-[36px];
    }
    & .btn--sienna {
      @apply text-[15px] font-sourcesans font-bold normal-case tracking-normal p-[8px_15px_6px_15px];
    }
    & .price-label {
      @apply text-[#343C3D] text-[20px] leading-none mb-3;
    }
    & .price-plan {
      @apply font-sourcesans font-semibold text-[#3A5E94] xl:text-axa-sienna-400 text-[24px] xl:text-[36px] leading-none my-1 xl:my-2 block;
    }
    & .total-plan {
      @apply text-axa-ocean-200 text-[16px] hidden lg:block xl:block;
    }
    & .view-detail {
      @apply text-axa-sienna-400 xl:hidden;
      & span {
        @apply inline-block relative before:absolute before:h-[1px] before:w-full before:bg-axa-sienna-400 before:-bottom-[3px];
      }
      & i {
        @apply ml-1;
      }
    }
    & .col {
      @apply last:text-right;
      &:nth-child(1) {
        @apply hidden xl:block;
      }
      &:nth-child(3) {
        &.align-self-center {
          @apply self-end xl:self-center;
        }
      }
      & .btn--dark-blue {
        @apply p-[12px_30px_10px_30px];
      }
    }
    & svg {
      & path {
        @apply stroke-white;
      }
    }
  }

  & .sticky-plan__summary {
    @apply py-3 xl:py-6;
    &.is-hide {
      @apply invisible opacity-0;
    }
    & .sticky-plan__summary-grid {
      @apply grid grid-cols-[1fr] md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2;
      & .price {
        @apply block xl:flex xl:gap-10;
        & .price-left {
          & p {
            @apply text-[16px] xl:text-[20px];
          }
          & strong {
            @apply block font-sourcesans font-semibold text-[22px] xl:text-[26px];
          }
        }
        & .price-right {
          @apply self-end mb-2;
          & a {
            @apply text-[14px] xl:text-[16px];
            & span {
              @apply text-[#F15A23] inline-block relative before:absolute before:h-[1px] before:w-full before:bg-axa-sienna-400 before:-bottom-[3px];
              transition: 0.4s all;
              & i {
                @apply text-[14px] ml-[6px];
              }
            }
            &:hover {
              & span {
                @apply text-axa-blue-400 before:bg-axa-blue-400;
              }
            }
          }
        }
      }
      & .col {
        @apply last:text-right last:self-end last:mt-2 lg:last:mt-0;
        &:nth-child(2) {
          & .btn {
            @apply text-[12px] xl:text-[14px] min-w-full md:min-w-[155px] lg:min-w-[155px] xl:min-w-[155px] text-center;
            & i {
              @apply ml-2;
            }
          }
        }
      }
    }
  }
  & .sticky-collapse-promo {
    @apply bg-white pt-3 pb-0 w-full absolute top-[56px] z-10 h-0 overflow-hidden opacity-0 invisible;
    transition: 0.2s all;
    & .sticky-collapse-promo__grid {
      @apply grid grid-cols-1 xl:grid-cols-[1fr_3fr] gap-6;
    }
    &.is-show {
      @apply h-[186px] lg:h-[117px] opacity-100 visible;
    }
    & label {
      @apply text-[#757575] block mb-2;
    }
    & .input-group-axa {
      & button {
        @apply p-[12px];
        & svg {
          @apply stroke-axa-blue-400;
          transition: 0.4s all;
        }
        &:hover {
          & svg {
            @apply stroke-axa-sienna-400;
          }
        }
      }
    }
    & .col {
      @apply last:last:mb-2 last:text-right last:self-end;
      &:nth-child(2) {
        & .btn {
          @apply min-w-[100%] xl:min-w-[210px];
        }
        & i {
          @apply ml-[6px];
        }
      }
    }
  }
  & .sticky-plan-collapse-summary {
    @apply pt-[28px] pb-6 absolute w-full bg-white top-[56px] h-0 opacity-0 invisible;
    transition: 0.2s all;
    &.is-show {
      @apply h-[420px] xl:h-[167px] visible opacity-100;
    }
    & .sticky-plan-collapse-summary__grid {
      @apply xl:grid xl:grid-cols-[1.2fr_5fr_1fr] xl:gap-8;
      & .col {
        &:nth-child(3) {
          @apply self-center text-right;
          & .btn {
            @apply min-w-full xl:min-w-[155px] text-center;
            & i {
              @apply ml-[6px];
            }
          }
        }
      }
    }
    & .sticky-plan-collapse-summary-sa__grid {
      @apply xl:grid xl:grid-cols-[5fr_1fr] xl:gap-8;
      & .col {
          &:nth-child(2) {
              @apply self-center;
              & .btn {
                  @apply min-w-[100%] xl:min-w-[235px] text-center;
                  & i {
                      @apply ml-[6px];
                  }
              }
          }
      }
    }
    & #select-plan-wrapper {
      @apply mb-4 xl:mb-0;
    }
    & .select2-container--default {
      & .select2-selection--single {
        border-top: none;
        border-right: none;
        border-left: none;
        border-bottom: 2px solid #00008f;
      }
    }
    & .select2-container {
      & .select2-selection--single {
        & .select2-selection__rendered {
          padding-left: 0px;
          padding-right: 0px;
        }
      }
    }
    & .select2-selection__rendered {
      @apply text-[25px] text-axa-bluesky-900 font-publico font-semibold;
    }
    & .select2-container--open {
      & .select2-dropdown::before {
        display: none;
      }
    }
    & .select2-results__option--selectable {
      @apply font-publico;
      text-transform: none;
    }
    & .select2-container--default {
      & .select2-selection--single {
        & .select2-selection__arrow {
          & b {
            margin-left: 0px;
          }
        }
      }
    }
    & label {
      @apply relative;
      &:before {
        @apply text-[#3A5E94] absolute right-2 top-[5px] -translate-y-1/2;
        font-family: "Font Awesome 5 Pro";
        font-weight: 900;
        content: "\f0d7";
      }
    }
    & select {
      @apply relative w-full bg-transparent appearance-none border-b-[2px] border-b-axa-blue-400 outline-none font-bold font-publico text-axa-bluesky-900 text-[40px] mb-3;
    }
    & p {
      @apply text-[20px];
    }
    & .col-grid {
      @apply hidden md:hidden xl:grid xl:grid-cols-[3fr_1fr] gap-2;
      & p {
        @apply mb-2;
      }
    }
    & .protection {
      @apply grid grid-cols-[1.5fr_1fr] gap-4;
      & ul {
        @apply mb-1 last:mb-0;
        & li {
          @apply flex gap-4;
          & span {
            @apply text-[#7698CB];
            &:first-child {
              @apply w-[80px] text-[#343C3D];
            }
          }
        }
      }
      .col {
        &:first-child {
            & ul {
                & li {
                    & span {
                        &:first-child {
                            @apply w-[135px];
                        }
                    }
                }
            }
        }
      }
    }
    & .total-premi {
      & span,
      & small {
        @apply block;
      }
      & span {
        @apply text-[24px] text-[#3A5E94] font-semibold;
      }
      & .discount {
        @apply text-[16px] line-through;
      }
      & small {
        @apply text-[#7698CB] text-[14px];
      }
    }
    & .col-grid-responsive {
      @apply xl:hidden;
      & p {
        @apply mb-1;
      }
      & ul {
        @apply mb-2;
        & li {
          @apply grid grid-cols-[1fr_1fr_1.5fr] last:grid-cols-[1fr_2.5fr] xl:last:grid-cols-[1fr_2fr] gap-1 mb-1;
          & span {
            @apply text-[#3A5E94] first:text-[#343C3D] first:w-[110px];
          }
          &:nth-child(3) {
            @apply mt-1;
            & span {
              &:nth-child(3) {
                @apply text-[#343C3D];
              }
            }
          }
        }
      }
      & .total-premi {
        @apply grid grid-cols-2 mb-[10px];
      }
    }
    /* & ul {
                @apply mt-[2px];
                & li {
                    @apply text-[#343C3D] grid grid-cols-2 mb-2;
                    &:nth-child(3) {
                        @apply mb-[8px];
                    }
                    &:nth-child(1),
                    &:nth-child(2),
                    &:nth-child(3) {
                        & span {
                            &:nth-child(1) {
                                @apply pl-6;
                            }
                        }
                    }

                    & span {
                        @apply text-[16px] last:text-[#7698CB];
                    }
                    & strong {
                        @apply block;
                    }
                }
            } */
  }
}
.banner-bottom {
  @apply bg-axa-blue-400;
  & .banner-bottom__inner {
    @apply grid grid-cols-1 lg:grid-cols-2;
  }
  & h1 {
    @apply text-white text-[25px] lg:text-[40px] mb-4 leading-tight lg:leading-[50px];
  }
  & .col--inner {
    @apply max-w-[550px] mx-auto px-6 pt-6 lg:px-0 lg:pt-0;
  }
  & .col {
    @apply last:mt-[30px] lg:last:mt-0;
  }
  & .btn {
    @apply text-[12px] p-[12px_20px_10px_20px];
  }
}
footer h5 {
  @apply font-semibold text-white text-[16px] uppercase tracking-[1px] mb-[15px];
}
.footer__inner {
  @apply bg-axa-ocean-200 pt-[45px];
}
.footer-wrapper__grid {
  @apply lg:grid lg:grid-cols-[2fr_1fr];
}
.footer-wrapper__sitemap--inner {
  @apply lg:flex;
  & .col-sitemap ul {
    @apply columns-2 lg:columns-1;
  }
  & .col-sitemap ul li a {
    @apply text-white;
  }
  & .col-sitemap h5 {
    @apply text-white;
  }
  & .col-sitemap ul li a {
    @apply text-[16px] transition duration-300 ease-in-out hover:underline;
  }
  & .col-sitemap {
    @apply lg:grow mb-2 lg:mb-0;
  }
  & .col-sitemap:nth-child(2) ul {
    @apply columns-2 lg:columns-2 mb-4 lg:mb-0;
  }
}
.footer-wrapper__contact {
  & .phone-contact {
    & a {
      @apply hover:underline;
    }
  }
}
.social-media ul {
  @apply flex gap-7;
}
.social-media ul li a {
  @apply text-white text-[20px] transition duration-300 ease-in-out hover:text-axa-blue-400;
}
.social-media ul li:nth-child(4) {
  & .group {
    @apply transition duration-300 ease-in-out fill-white;
    &:hover {
      @apply fill-axa-blue-400;
    }
  }
}
.copyright {
  @apply border-t border-axa-ocean-100 mt-[45px] py-[15px];
  & .copyright__wrapper {
    @apply md:container md:mx-auto;
    & a {
      @apply underline hover:no-underline;
    }
  }
}

