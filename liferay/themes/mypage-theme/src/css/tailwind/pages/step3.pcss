.checkBoxSpanDataSamePolis {
  @apply font-bold text-[14px] uppercase pl-3 text-[#757575];
}

.step3 .accordion-collapse {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: height 0.5s ease-out, opacity 0.5s ease-out;
}

.step3 .accordion-collapse.show {
  height: auto;
  opacity: 1;
  display: block;
}

#custom-checkbox:checked + label div {
  background-color: #4976ba;
  border-color: #4976ba;
}

#custom-checkbox:checked + label div svg {
  display: block;
}

