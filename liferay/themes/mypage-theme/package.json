{
	"name": "mypage-theme",
	"version": "1.0.0",
	"main": "package.json",
	"keywords": [
		"liferay-theme"
	],
	"liferayTheme": {
		"baseTheme": "styled",
		"fontAwesome": true,
		"screenshot": "",
		"templateLanguage": "ftl",
		"version": "7.3"
	},
	"devDependencies": {
		"autoprefixer": "^10.4.16",
		"caniuse-lite": "^1.0.30001620",
		"compass-mixins": "0.12.10",
		"gulp": "4.0.2",
		"liferay-font-awesome": "3.4.0",
		"liferay-frontend-common-css": "1.0.4",
		"liferay-frontend-theme-styled": "5.0.15",
		"liferay-frontend-theme-unstyled": "5.0.20",
		"liferay-theme-tasks": "^10.5.3",
		"postcss": "^8.4.31",
		"tailwindcss": "^3.3.3"
	},
	"scripts": {
		"init": "gulp init",
		"build": "gulp build",
		"deploy": "gulp deploy",
		"extend": "gulp extend",
		"kickstart": "gulp kickstart",
		"status": "gulp status",
		"upgrade": "gulp upgrade",
		"watch": "gulp watch",
		"build:tailwind": "npx tailwind -i src/css/tailwind/input.css -o src/css/tailwind/dist/output.css",
		"watch:tailwind": "npx tailwind -i src/css/tailwind/input.css -o src/css/tailwind/dist/output.css --watch"
	}
}
