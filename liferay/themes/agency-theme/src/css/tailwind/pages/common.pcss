.html__agency,
.body__agency {
  @apply h-full font-sourcesans font-normal;
}

.body__agency {
  @apply bg-[#FAFAFA];
}

.body-white {
  @apply bg-[#FAFAFA];
}

.portlet-decorate .portlet-content__agency {
  @apply bg-transparent p-0;
}

.dashboard__agency {
  @apply pt-4 md:pt-[33px] xl:pt-[45px] md:pb-[33px] xl:pb-[80px];
}

.container-fluid {
  @apply p-0;
}

.container-nav-axa {
  @apply container max-w-full sm:max-w-full md:max-w-[1140px] lg:max-w-[1200px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1300px] xl:max-w-[1220px] 2xl:max-w-[1336px] mx-[15px] lg:p-[0px_20px_0px_20px] xl:p-[0px_0px_0px_0px] lg:mx-auto xl:mx-auto;
}

.container-breadcrumbs-axa {
  @apply container sm:max-w-[720px] md:max-w-[1140px] lg:max-w-[1170px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1300px] xl:max-w-[1220px] 2xl:max-w-[1336px] p-[95px_15px_15px_15px] sm:p-[95px_15px_15px_15px] lg:p-[15px_15px_15px_15px] lg:mx-auto xl:p-[15px_0px] xl:mx-auto;
}

.container-axa {
  @apply container sm:max-w-full md:max-w-[1140px] lg:max-w-[1170px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1300px] xl:max-w-[1220px] 2xl:max-w-[1336px] p-[0px_15px] lg:mx-auto xl:p-0 xl:mx-auto;
}

.container-axa-login {
  @apply container sm:max-w-[500px] md:max-w-[550px] lg:max-w-[980px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1400px] xl:max-w-[1140px] 2xl:max-w-[1336px] px-[1rem] sm:px-[1rem] md:px-[1rem] lg:px-[1rem] 2xl:px-0 md:mx-auto lg:mx-auto h-full;
}

.container-axa-succesful {
  @apply container max-w-full lg:max-w-[850px] mx-auto;
}

.container-axa-blogs {
  @apply max-w-[852px] mx-auto pt-[15px] lg:pt-[40px] pb-[40px];
}

.container__agency {
  @apply sm:max-w-full md:max-w-[1140px] lg:max-w-[1170px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1300px] xl:max-w-[1336px] 2xl:max-w-[1336px] p-[0px_15px] lg:mx-auto xl:p-0 xl:mx-auto;
}

.breadcrumbs {
  @apply mb-0;
  & li {
    @apply text-axa-grey-600;
    & span {
      @apply mx-3 lg:mx-4 text-axa-grey-400;
    }
    & a {
      @apply text-axa-sienna-400 uppercase transition duration-300 ease-in-out hover:text-axa-grey-600 hover:no-underline;
    }
  }
}

.nav-axa-wrapper {
  @apply bg-white flex-nowrap flex w-full items-center justify-between py-3 lg:flex-wrap lg:justify-start lg:py-6 border-b border-gray-100 fixed lg:static xl:static top-0 z-[1030];
  & .brand-logo {
    @apply flex items-center lg:hidden;
  }
  & .brand-logo-responsive {
    @apply mb-4 lg:mr-2 xl:mr-8 mt-3 items-center lg:mb-0 lg:mt-0 hidden lg:flex;
  }
}

.nav-left {
  @apply flex-grow basis-full items-center hidden lg:flex lg:basis-auto;
}

.nav-right {
  @apply relative items-center hidden lg:flex;
  & .dropdown-toggle--user {
    @apply uppercase whitespace-nowrap flex gap-20px items-center transition duration-150 ease-in-out text-axa-blue-300
        hover:text-axa-ocean-200;
    & img {
      @apply rounded-full;
    }
    &.show {
      @apply text-axa-ocean-200;
    }
  }
}

.nav-axa-button {
  @apply lg:hidden;
  & button {
    @apply lg:hidden border-0 bg-transparent;
  }
}

@media (max-width: 768px) {
  .nav-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.08);
  }
}

@media (min-width: 600px) {
  .nav-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}

@media (min-width: 900px) {
  .nav-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}

@media (min-width: 992px) {
  .nav-axa-wrapper {
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  }
}

@media (min-width: 1024px) {
  .nav-axa-wrapper {
    box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, 0);
  }
}

@media (min-width: 1200px) {
  .nav-axa-wrapper {
    box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, 0);
  }
}

.nav-ul {
  @apply list-none mr-auto flex flex-col pl-0 lg:flex-row xl:gap-2 lg:mt-0;
  & li {
    @apply relative lg:self-center;
    & a {
      @apply text-axa-grey-800 transition ease-in p-[8px_15px_8px_15px] xl:p-[8px_25px_8px_25px];
      & svg {
        @apply relative top-[-2px];
        & path {
          @apply stroke-axa-grey-800 transition ease-in;
        }
      }
      &.is-active {
        @apply bg-axa-ocean-100 text-white;
        & svg {
          & path {
            @apply stroke-white;
          }
        }
      }
      &.is-active-link {
        @apply text-axa-ocean-100;
        & svg {
          & path {
            @apply stroke-axa-ocean-100;
          }
        }
      }
    }
    & a:hover {
      @apply text-axa-ocean-100;
    }
    & a:hover svg path {
      @apply stroke-axa-ocean-100;
    }
    & a.is-active:hover {
      @apply text-white;
      & svg {
        & path {
          @apply stroke-white;
        }
      }
    }
  }
}

#navbar {
  @apply bg-white w-full fixed h-[100dvh] top-[75px] left-[100%] z-[1020];
  transition: 0.4s all;
  &.is-show {
    @apply lg:hidden;
  }
  & ul {
    @apply pt-[5px] overflow-y-scroll;
    & li {
      @apply border-b border-[#EEEEEE] last:border-none;
      & a {
        & img {
          @apply rounded-full;
        }
        & span {
          @apply group-hover:text-white;
        }
        &.is-active-link {
          @apply bg-transparent text-axa-ocean-100;
          & .span-wrapper {
            @apply bg-axa-ocean-100;
          }
        }
      }
    }
    & a.is-active-link:hover {
      @apply text-white;
    }
    & a.is-active-link:hover svg path {
      @apply stroke-white;
    }
  }
  & .dropdown-item {
    &:hover {
      @apply bg-transparent text-axa-ocean-100;
    }
  }
  & .dropdown-item--logout {
    @apply block px-[15px];
  }
  &.is-show {
    @apply left-[0%];
  }
  & .btn-logout {
    @apply bg-white w-full absolute bottom-[15%] p-3 left-0;
  }
}

@media only screen and (min-width: 320px) {
  #navbar ul {
    max-height: 390px;
  }
}

@media only screen and (min-width: 375px) {
  #navbar ul {
    max-height: 380px;
  }
}

@media only screen and (min-width: 390px) {
  #navbar ul {
    max-height: 560px;
  }
}

@media only screen and (min-width: 393px) {
  #navbar ul {
    max-height: 480px;
  }
}

@media only screen and (min-width: 414px) {
  #navbar ul {
    max-height: 450px;
  }
}

@media only screen and (min-width: 768px) {
  #navbar ul {
    max-height: 100%;
  }
}

.wrapper__agency {
  @apply lg:flex lg:justify-between;
}

.h4__agency {
  @apply font-bold text-[28px] text-axa-grey-800 lg:text-[36px];
}

.label__agency {
  @apply font-semibold text-axa-grey-600 text-[16px] mb-[10px] block;
}

.btn__agency {
  @apply text-white text-[14px] uppercase tracking-[1px] p-[12px_10px_10px_10px] xl:p-[12px_15px_10px_18px] border-transparent transition-[0.4s];
}

.btn__agency {
  &.btn--dark-blue {
    @apply bg-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:rounded-sm before:bg-axa-blue-100 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }

  &.btn--green {
    @apply bg-axa-green-500 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-green-600 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }

  &.btn--white-outline {
    @apply text-white bg-transparent border border-white relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-white before:duration-300 before:ease-out hover:text-axa-blue-300 hover:before:h-40 hover:before:w-full hover:before:opacity-100;
  }

  &.btn--dark-blue-outline {
    @apply text-axa-blue-400 bg-white border border-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-blue-300 before:duration-300 before:ease-out hover:text-white hover:before:h-40 hover:before:w-full hover:before:opacity-100;
  }

  &.btn--sienna {
    @apply bg-axa-sienna-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:rounded-sm before:bg-axa-sienna-200 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }

  &.btn--disabled {
    @apply pointer-events-none cursor-not-allowed text-[#999999] bg-axa-grey-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:rounded-sm before:bg-axa-grey-500 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }

  &.btn--grey {
    @apply text-axa-grey-800 bg-axa-grey-300 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-grey-400 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
  }
}

.link-hover {
  @apply transition ease-in;

  &.link-hover--white {
    @apply hover:text-axa-grey-200;
    &:hover {
      & svg {
        & path {
          @apply stroke-axa-grey-200;
        }
      }
    }
  }

  &.link-hover--blue {
    @apply hover:text-axa-sienna-400 !important;
  }

  &.link-hover--sienna {
    @apply hover:text-axa-blue-400 !important;
  }
}

.order-10 {
  @apply z-10;
}

.order-50 {
  @apply z-50;
}

.icon-right {
  @apply inline-block align-[-2px];
}

.white-row {
  @apply bg-white;
}

.grey-row {
  @apply bg-gray-200;
}

.win {
  & .input-switch {
    @apply before:top-[-2px];
  }
}

.input-switch {
  @apply relative shrink-0 w-[2.25rem] h-5 bg-white checked:bg-none checked:bg-axa-blue-400 checked:border-axa-blue-400 rounded-full cursor-pointer transition-colors ease-in-out duration-200 border-2 border-axa-grey-400 focus:outline-none appearance-none 
before:relative before:top-[-2px] before:inline-block before:w-[14px] before:h-[14px] before:bg-axa-grey-400 checked:before:bg-white before:translate-x-[2px] checked:before:translate-x-[16px] before:shadow before:rounded-full before:transform before:ring-0 before:transition before:ease-in-out before:duration-200;
}

.input-date {
  @apply bg-[url('../../../images/icon_calendar.svg')] bg-no-repeat bg-[length:22px] bg-[right_15px_center];
}

.input-control {
  @apply p-[14px] w-full text-axa-grey-800 outline-none placeholder:font-normal placeholder:text-[#bababa] placeholder:normal-case;

  &.input-control--outline {
    @apply border border-axa-grey-400 focus:outline-2 focus:outline focus:outline-transparent;
  }
}

input.disabled {
  @apply !bg-axa-grey-300 text-[#111B1D80];
}

select.input-control {
  @apply bg-gray-50 border border-gray-300 text-gray-900 focus:ring-blue-500 focus:border-blue-500 block w-full p-[14px] normal-case;
}

textarea.input-control {
  @apply text-[16px] text-axa-grey-800 block border-axa-grey-400 w-full min-h-[130px] border bg-transparent p-[14px] outline-none transition-all duration-200 ease-linear normal-case placeholder:font-normal placeholder:text-[#bababa] placeholder:normal-case;
}

.input-group {
  @apply flex relative;
  & .btn-group {
    @apply absolute bg-white h-[50px] p-[15px] block top-[50%] right-0;
    transform: translate(-2px, -50%);
  }
}

.input-control {
  &.error-text {
    @apply border border-axa-red-error;
  }
}

.table-wrapper {
  @apply max-w-[500px] sm:max-w-full md:max-w-full lg:max-w-full xl:max-w-full mx-auto overflow-x-auto;
}

.table__agency {
  @apply relative w-full table-auto xl:table-fixed whitespace-nowrap xl:whitespace-normal before:bg-axa-grey-300 before:w-full before:h-[1px] before:absolute before:top-0 before:left-0 before:xl:hidden before:z-[100];

  & label {
    @apply text-[12px];
  }
  & thead {
    & td {
      @apply bg-white text-[12px] text-[#757575] xl:border-t xl:border-t-axa-grey-300 border-b border-b-axa-sienna-400 p-[15px_10px_12px_10px] uppercase font-semibold;
      & .checkbox-custom-wrapper {
        & span {
          margin-left: 5px;
        }
      }
    }
    & td:nth-child(1) {
      @apply relative xl:border-l xl:border-l-axa-grey-300 before:bg-axa-grey-300 before:absolute before:top-0 before:left-[0px] before:w-[1px] before:h-full xl:before:hidden
			after:bg-axa-red-error after:absolute after:w-full after:h-[1px] after:bottom-[-1px] after:left-0 xl:after:hidden;
    }
    & td:last-child {
      @apply border-r border-r-axa-grey-300;
    }
    & tr {
      @apply [&>*:nth-child(1)]:sticky xl:[&>*:nth-child(1)]:static [&>*:nth-child(1)]:left-[0px] [&>*:nth-child(1)]:z-50;
    }

    & td {
      @apply bg-white text-[12px] text-[#757575] border-t border-t-axa-grey-300 border-b border-b-axa-sienna-400 p-[15px_10px_12px_10px] uppercase font-semibold;
    }
  }
  & tbody,
  & tfoot {
    & tr {
      & td {
        @apply bg-white text-[11px] text-[#343C3D] font-semibold tracking-[0.866px] uppercase border-b border-[#dddddd] p-[15px_10px_15px_10px] transition-all;
      }
      & td:nth-child(1) {
        @apply border-l border-l-axa-grey-300 before:bg-white before:absolute before:top-0 before:left-[-1px] before:w-[1px] before:h-full;
      }
      & td:nth-child(4) {
        @apply tracking-[0px] font-semibold normal-case;
      }
      & td:last-child {
        @apply border-r border-r-axa-grey-300;
      }
      &.expire {
        & td {
          @apply text-[#999999];
        }
      }
      &.approve {
        & td {
          @apply text-axa-green-500;
        }
      }
    }
    & tr {
      @apply [&>*:nth-child(1)]:bg-white [&>*:nth-child(3)]:font-normal [&>*:nth-child(3)]:normal-case [&>*:nth-child(3)]:tracking-normal [&>*:nth-child(3)]:text-[12px] even:bg-[#EFEFEF] [&>*:nth-child(1)]:sticky  xl:[&>*:nth-child(1)]:static [&>*:nth-child(1)]:left-[0px];
    }
    & tr:nth-child(even) td {
      @apply bg-[#EFEFEF];
    }
  }
}

.pagination {
  @apply inline-flex -space-x-px text-[10pt] lg:text-sm mt-8 mb-8 md:mb-0 lg:mb-0;
  & .prev {
    @apply !hidden lg:!flex;
  }
  & .prev-mobile {
    @apply lg:!hidden;
  }
  & .next {
    @apply !hidden lg:!flex;
  }
  & .next-mobile {
    @apply lg:!hidden;
  }
  & li {
    & a {
      @apply bg-white transition ease-in border-b-2 border-transparent text-axa-blue-400 uppercase font-semibold tracking-[1px] flex items-center justify-center px-3 h-8 ms-0 leading-tight hover:border-b-2 hover:border-axa-sienna-400;
    }
    & a.active {
      @apply flex text-axa-sienna-400 items-center justify-center px-3 h-8 border-b-2 border-axa-sienna-400;
    }
    & a.disabled {
      @apply text-axa-grey-400 pointer-events-none;
    }
  }
  & li:first-child,
  & li:last-child {
    & a {
      @apply bg-transparent hover:border-transparent hover:text-axa-sienna-400;
    }
  }
}

.modal-agency {
  & span.error-text,
  & span.note-text {
    @apply text-axa-red-error font-normal text-[13px] mt-[4px];
  }
  & .modal-agency-body {
    & p {
      @apply mb-6;
    }
    & .accordion-button__right {
      & p {
        @apply mb-0;
      }
    }
  }
}

.modal-agency {
  @apply h-full overflow-x-hidden overflow-y-auto;
  padding: 1rem !important;
  /* overflow: hidden !important; */
}

.modal-agency {
  @apply fixed outline-none z-[1055] top-2/4 left-2/4 translate-y-[-50%] translate-x-[-50%];
  & .modal-agency-dialog {
    @apply mx-auto relative min-[576px]:m-auto;
  }
  & .modal-agency-content {
    @apply bg-white w-full h-full border-none shadow-none rounded-none;
  }
  & .modal-agency-header {
    @apply border-b border-axa-grey-200;
    & h1 {
      @apply font-publico font-bold text-axa-grey-800 text-[24px] lg:text-[32px];
    }
  }
  & .modal-agency-footer {
    @apply flex justify-between border-axa-grey-300 border-t p-20px-30px mt-12;
  }
  &.fade {
    & .modal-agency-dialog {
      transition: transform 0.3s ease-out;
      transform: translate(0, -50px);
    }
  }
  &.show {
    & .modal-agency-dialog {
      transform: none;
    }
  }
}

.fade {
  transition: opacity 0.15s linear;
}

.fade:not(.show) {
  opacity: 0;
}

.modal-backdrop {
  @apply fixed w-[100vw] h-full bg-black/40 top-0 left-0 z-[1050] backdrop-blur;
  &.fade {
    @apply opacity-0;
  }
  &.show {
    @apply opacity-[1];
  }
}

.modal-agency-dialog-centered {
  display: flex;
  align-items: center;
  min-height: calc(100% - 0px * 2);
}

#toggle-menu {
  -webkit-tap-highlight-color: transparent;
}
#hamburger {
  @apply relative outline-none shadow-none focus:outline-none;
  & span {
    @apply bg-axa-blue-400 w-[28px] h-[3px] absolute right-0;
    transition: 0.4s all;
  }
  & span:nth-child(1) {
    @apply top-[-12px];
  }
  & span:nth-child(2) {
    @apply top-[-4px];
  }
  & span:nth-child(3) {
    @apply top-[4px] visible;
    transition: 0.4s all;
    opacity: 1;
  }
  &.is-anime {
    & span:nth-child(1) {
      transform: rotate(45deg);
      top: -4px;
    }
    & span:nth-child(2) {
      top: -4px;
      transform: rotate(-45deg);
    }
    & span:nth-child(3) {
      @apply invisible opacity-0;
      transform: rotate(45deg);
      top: -4px;
    }
  }
}
#navbar {
  @apply bg-white w-full fixed h-[100dvh] top-[75px] left-[100%] z-[1020];
  transition: 0.4s all;
  &.is-show {
    @apply lg:hidden;
  }
  & ul {
    @apply pt-[5px];
    & li {
      @apply border-b border-[#EEEEEE] last:border-none;
      & a {
        &.is-active-link {
          @apply bg-transparent text-axa-ocean-100;
          & .span-wrapper {
            @apply bg-axa-ocean-100;
          }
        }
      }
    }
    & a.is-active-link:hover {
      @apply text-white;
    }
    & a.is-active-link:hover svg path {
      @apply stroke-white;
    }
  }
  & .dropdown-item {
    &:hover {
      @apply bg-transparent text-axa-ocean-100;
    }
  }
  & .dropdown-item--logout {
    @apply block px-[15px];
  }
  &.is-show {
    @apply left-[0%];
  }
  & .btn-logout {
    @apply bg-white w-full absolute bottom-[15%] p-3 left-0;
  }
}

@media only screen and (min-width: 320px) {
  #navbar ul {
    max-height: 390px;
  }
}

@media only screen and (min-width: 375px) {
  #navbar ul {
    max-height: 380px;
  }
}

@media only screen and (min-width: 390px) {
  #navbar ul {
    max-height: 560px;
  }
}

@media only screen and (min-width: 393px) {
  #navbar ul {
    max-height: 480px;
  }
}

@media only screen and (min-width: 414px) {
  #navbar ul {
    max-height: 450px;
  }
}

@media only screen and (min-width: 768px) {
  #navbar ul {
    max-height: 100%;
  }
}

.dropdown-menu-alt {
  @apply !ml-[25px];
}
.dropdown-menu-alt {
  @apply w-[232px] absolute bg-white opacity-0 invisible z-[1030];
  transition: 0.4s all;
  box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
  &.dropdown-menu--user {
    @apply w-full lg:w-[325px] invisible opacity-0 !ml-[0px] !left-[-130px];
  }
  & li {
    @apply border-b border-b-[#EEEEEE] last:border-none;
  }
  & .dropdown-item {
    @apply text-[16px] block p-[10px_15px_10px_15px] transition-all ease-in hover:bg-axa-blue-400 hover:text-white;
    &.dropdown-item--logout {
      @apply p-[15px] hover:bg-transparent;
    }
    &.dropdown-item {
      &.is-active-link {
        @apply text-white hover:text-white bg-axa-blue-300;
      }
    }
  }
  &.show {
    @apply visible opacity-100;
    transition: 0.4s all;
  }
}
.dropdown-menu--portofolio {
  @apply w-full !static hidden !ml-0;
  transform: translate3d(0px, 0px, 0px) !important;
  box-shadow: none;
  &.dropdown-item {
    &.is-active-link {
      @apply text-axa-ocean-200;
    }
  }
  &.show {
    @apply block;
  }
}

.dropdown-menu-alt {
  @apply !top-[25px];
}
.dropdown-toggle-alt {
  & .fa-caret-down {
    @apply transition ease-in;
  }
  &.show {
    @apply text-axa-ocean-100;
    & .fa-caret-down {
      transform: rotate(180deg);
    }
  }
  &.dropdown-toggle--user {
    @apply p-[8px_10px] rounded-[35px] underline hover:no-underline ease-in hover:text-axa-ocean-100;
    &.show {
      @apply no-underline;
    }
  }
}

