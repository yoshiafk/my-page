span.note-text {
  @apply text-axa-red-error font-normal text-[13px] mt-[4px];
}

.btn-date {
  @apply text-white uppercase text-[12px] p-[8px_16px];
  &.btn-apply {
    @apply bg-axa-blue-400;
  }
  &.btn-cancel {
    @apply text-axa-blue-400;
  }
}

footer h5 {
  @apply font-semibold text-white text-[16px] uppercase tracking-[1px] mb-[15px];
}

.footer__inner {
  @apply bg-axa-ocean-200 pt-45px;
}

.footer-wrapper__sitemap--inner {
  @apply lg:flex;
  & .col-sitemap ul {
    @apply columns-2 lg:columns-1;
  }
  & .col-sitemap ul li a {
    @apply text-white;
  }
  & .col-sitemap h5 {
    @apply text-white;
  }
  & .col-sitemap ul li a {
    @apply text-[16px] transition duration-300 ease-in-out hover:underline;
  }
  & .col-sitemap {
    @apply lg:grow mb-2 lg:mb-0;
  }
  & .col-sitemap:nth-child(2) ul {
    @apply columns-2 lg:columns-2 mb-4 lg:mb-0;
  }
}

.footer-wrapper__contact {
  & .phone-contact {
    & a {
      @apply hover:underline;
    }
  }
}

.footer-wrapper__grid {
  @apply lg:grid lg:grid-cols-[2fr_1fr];
}

.social-media ul {
  @apply flex gap-7;
}

.social-media ul li a {
  @apply text-white text-[20px] transition duration-300 ease-in-out hover:text-axa-blue-400;
}

.social-media ul li:nth-child(4) {
  & .group {
    @apply transition duration-300 ease-in-out fill-white;
    &:hover {
      @apply fill-axa-blue-400;
    }
  }
}

.copyright {
  @apply border-t border-axa-ocean-100 mt-45px py-15px;
  & .copyright__wrapper {
    @apply md:container md:mx-auto;
    & a {
      @apply underline hover:no-underline hover:text-inherit;
    }
  }
}

.alert-agency {
  @apply text-14px text-center p-10px-2px-10px-2px;
  & span {
    @apply text-white p-6px-0px block relative;
  }
  &.failed {
    @apply bg-axa-red-error;
  }
  &.success {
    @apply bg-axa-green-500;
  }
}

#ModalCreateReminder {
  & .modal-agency-header {
    @apply p-[18px_20px];
  }
  & .modal-agency-body {
    & sup {
      @apply text-[14px] text-axa-red-error ml-[2px] inline-block align-[-4px];
    }
  }
  & .modal-agency-footer {
    & .btn-create-reminder {
      & svg {
        & path {
          @apply stroke-white;
        }
      }
    }
    & .btn-cancel-create-reminder,
    & .btn-prev-create-reminder {
      @apply text-axa-blue-400 font-semibold hover:underline;
    }
  }
}

#ModalBackReminder,
#ModalBack,
#ModalBackReminder,
#ModalPromoCode,
#ModalEditPromoCode,
#ModalEditBackPromoCode {
  & .modal-agency-body {
    & h1 {
      @apply text-axa-grey-800 font-publico font-bold;
    }
    & p {
      @apply text-axa-grey-600;
    }
  }
  & .btn-no {
    @apply text-axa-blue-300 text-14px font-semibold hover:underline;
  }
}

#ModalPromoCode,
#ModalEditPromoCode {
  & .modal-agency-body {
    & sup {
      @apply text-[14px] text-axa-red-error ml-[2px] inline-block align-[-4px];
    }
  }
  & .modal-agency-footer {
    @apply mt-0;
    & .btn-promo-code,
    & .btn-edit-promo-code {
      & svg {
        & path {
          @apply stroke-white;
        }
      }
    }
    & .btn-cancel-create-promo,
    & .btn-cancel-edit-promo,
    & .btn-prev-promo-code {
      @apply text-axa-blue-400 font-semibold hover:underline;
    }
  }
}

#ModalPromoCode {
  & .label-max-coupon {
    @apply text-16px text-axa-grey-800 font-normal self-center mb-0 ml-8px cursor-pointer;
  }
  & .col-create-promo {
    @apply grid xl:grid-cols-2 gap-5;
  }
}

#ModalEditPromoCode {
  & .col-edit-promo {
    @apply grid xl:grid-cols-2 gap-5;
  }
}

#ModalLostConnection {
  & .modal-agency-body {
    @apply p-[40px_40px_35px_40px];

    & a {
      @apply hover:text-white hover:no-underline;
    }
  }
}

#ModalSuccessForgotpass,
#ModalSuccessReminder,
#ModalSuccessPromoCode,
#ModalSuccessEditPromoCode {
  & .modal-agency-body {
    & h1 {
      @apply text-axa-grey-800 font-publico font-bold;
    }
    & p {
      @apply text-axa-grey-600;
    }
  }
}

#ModalLostConnection {
  & h1 {
    @apply text-axa-grey-800 font-publico font-bold text-25px;
  }
}

#ModalSummaryCC {
  & .modal-agency-header {
    & h2 {
      @apply border-none;
    }
    & a {
      & i {
        @apply transition ease-in;
      }
      &:hover {
        & i {
          @apply text-axa-sienna-400;
        }
      }
    }
  }
  & .accordion-wrapper {
    @apply border-none;
  }
}

#ModalSalesTools {
  @apply overflow-y-hidden;
  & .play {
    @apply absolute left-2/4 top-2/4 -translate-x-2/4 -translate-y-2/4 cursor-pointer bg-white rounded-full p-[20px] opacity-100 transition-all hover:opacity-75;
    & img {
      @apply w-[30px];
    }
  }
  & .modal-header-agency {
    & .pause {
      @apply text-axa-grey-800 self-start transition ease-in hover:text-axa-sienna-400;
    }
    & .modal-agency-content__left {
      @apply col-span-12 lg:col-span-9;
      & p {
        @apply font-semibold text-axa-grey-600 mt-4;
      }
    }
    & .modal-agency-content__right {
      @apply col-span-12 lg:col-span-3 lg:text-right self-end;
      & .btn--dark-blue {
        @apply block lg:inline-block text-center mt-4 lg:mt-0;
      }
    }
  }
}

#ModalReferral {
  &.modal-agency {
    & .modal-agency-footer {
      @apply justify-end;
    }
  }
  & .copy-link {
    @apply hover:text-axa-sienna-400;
    transition: 0.4s all;
  }
  & .input-group {
    @apply block xl:flex;
    & .btn-group {
      @apply w-full md:w-auto xl:w-auto static md:absolute xl:absolute translate-x-[-1px] -translate-y-[0px] sm:xl:translate-x-[-1px] xl:translate-x-[-2px] md:-translate-y-2/4 xl:-translate-y-2/4;
    }
  }
}

.modal-dialog-iframe {
  overflow-y: scroll;
  max-height: 1020px;
}

@media (min-width: 600px) {
  .modal-dialog-iframe {
    margin-top: 70px;
  }
}

@media (max-width: 767px) {
  .modal-dialog-iframe {
    margin-top: 70px;
    max-height: 1710px;
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .modal-dialog-iframe {
    max-height: none;
  }
}

@media (min-width: 1024px) {
  .modal-dialog-iframe {
    margin-top: 0;
  }
}

.hide-icon-mobile {
  @apply hidden;
}