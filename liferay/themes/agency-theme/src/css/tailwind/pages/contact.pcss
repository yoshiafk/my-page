.mb-5level {
  @apply mb-[20px];
}

.contact-us {
  @apply bg-[url('../../../images/bg_contact_us.png')] bg-no-repeat bg-center bg-contain lg:bg-auto lg:bg-right pt-[50px] pb-[50px] lg:pt-[150px] lg:pb-[150px];
  & address {
    @apply max-w-[240px] not-italic text-[#343C3D];
  }
  & .map_part {
    @apply mt-6 mb-16 lg:mb-0;
  }
  & .contact-us__inner {
    @apply max-w-[1200px];
    & h1 {
      @apply max-w-[460px];
    }
  }
  & .contact-us-grid {
    @apply grid lg:grid-cols-3 xl:grid-cols-4 gap-3;
  }
  & .contact-us__left {
    @apply mt-6 lg:mt-0;
    & a {
      @apply bg-white border border-axa-grey-300;
      &:hover {
        @apply bg-axa-blue-300 border-axa-blue-300;
      }
    }
    & .chatbot-wrapper,
    & .email-wrapper {
      @apply grid p-[15px_30px] min-h-[122px] xl:min-h-full;
      & .chatbot-wrapper-inner,
      & .email-wrapper-inner {
        @apply grid grid-cols-[1fr_8fr] gap-5 transition-all;
        & i {
          @apply text-axa-blue-300 transition-all;
        }
        & span {
          @apply text-black self-center transition-all;
          & span {
            @apply text-axa-blue-300 break-all text-15px block;
            & span {
              @apply text-black transition-all inline-block;
            }
          }
        }
      }

      &:hover {
        & .chatbot-wrapper-inner,
        & .email-wrapper-inner {
          & i {
            @apply text-white;
          }
          & span {
            @apply text-white;
            & span {
              @apply text-white;
            }
          }
        }
      }
      &.send-email {
        @apply bg-axa-blue-400;
        & span,
        & i {
          @apply text-white;
        }
        & span {
          & span {
            @apply text-white;
          }
        }
        &:hover {
          @apply bg-white;
          & i {
            @apply text-axa-blue-400;
          }
          & span {
            @apply text-axa-blue-300;
            & span {
              @apply text-axa-blue-400;
            }
          }
        }
      }
      &.bde-call {
        @apply bg-axa-sienna-400;
        & .email-wrapper-inner {
          @apply grid-cols-1;
        }
        & span {
          @apply text-white;
        }
        &:hover {
          @apply bg-white;
          & span {
            @apply text-axa-blue-300;
            & span {
              @apply text-axa-blue-400;
            }
          }
        }
      }
      &.phone-call {
        & span {
          & span {
            @apply font-bold;
            & span {
              @apply font-normal block;
            }
          }
        }
      }
    }
  }
  & .contact-us__right {
    @apply col-span-12 lg:col-span-7 order-1 lg:order-2;
    & .multi-step-form {
      @apply bg-white border border-axa-grey-300 mt-8;
      & .contact__grid {
        @apply grid grid-cols-1 lg:grid-cols-2 gap-3;
      }
      & .contact-footer {
        @apply px-6 py-4 border-t border-axa-grey-300 text-right;
      }
    }
  }
}
