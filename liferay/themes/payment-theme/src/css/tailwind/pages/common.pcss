html,
body {
    @apply font-sourcesans font-normal;
}

html {
    scroll-behavior: smooth;
}

body {
    @apply bg-[#FAFAFA];
}

h1,
h2,
strong {
    @apply text-axa-bluesky-900 font-bold font-publico;
}

label {
    @apply font-semibold text-axa-grey-600 text-[16px] mb-[10px] block;
}

.topbar {
    @apply w-full py-4 fixed top-0 lg:static bg-white z-50;
    & .topbar__logo {
        @apply w-[100px];
    }

    & .topbar__link {
        @apply self-center;
        & a {
            @apply text-axa-blue-300 underline hover:no-underline;
        }
    }

    & .topbar__login {
        & a {
            @apply flex gap-3;
            & span {
                @apply self-center last:underline text-axa-blue-300;
            }
            &:hover {
                & span {
                    &:last-child {
                        @apply no-underline;
                    }
                }
            }
        }
    }

    & .topbar__nav {
        @apply flex gap-6;
        & .fas {
            @apply text-sm mr-2;
        }
        & li {
            @apply self-center;
        }
        & .topbar-link {
            @apply hover:text-axa-ocean-200;
            transition: 0.4s all;
        }
        & .btn {
            @apply rounded-[60px] tracking-[2px] p-[8px_22px_8px_22px] self-center;
        }
    }
}

.topbar-border-bottom {
    @apply w-full bg-gradient-to-b from-[#FF1721] to-[#FF1721] h-[12px] fixed left-0 top-[75px] lg:static z-50;
}

#hamburger {
    @apply relative outline-none shadow-none focus:outline-none;
    & span {
        @apply bg-axa-blue-400 w-[28px] h-[3px] absolute right-0;
        transition: 0.4s all;
    }
    & span:nth-child(1) {
        @apply top-[-12px];
    }
    & span:nth-child(2) {
        @apply top-[-4px];
    }
    & span:nth-child(3) {
        @apply top-[4px] visible;
        transition: 0.4s all;
        opacity: 1;
    }
    &.is-anime {
        & span:nth-child(1) {
            transform: rotate(45deg);
            top: -4px;
        }
        & span:nth-child(2) {
            top: -4px;
            transform: rotate(-45deg);
        }
        & span:nth-child(3) {
            @apply invisible opacity-0;
            transform: rotate(45deg);
            top: -4px;
        }
    }
}

.container-axa {
    @apply container sm:max-w-full md:max-w-[1140px] lg:max-w-[1170px] min-[1300px]:max-w-[1200px] min-[1440px]:max-w-[1300px] xl:max-w-[1220px] 2xl:max-w-[1336px] p-[0px_15px] lg:mx-auto xl:p-0 xl:mx-auto;
}

.container-axa-succesful {
    @apply container max-w-full lg:max-w-[850px] mx-auto;
}

.input-control {
    @apply p-[14px] w-full rounded-none text-axa-grey-800 uppercase outline-none placeholder:font-normal placeholder:text-[#bababa] placeholder:normal-case;
    &.input-control--outline {
        @apply border border-axa-grey-400;
    }
    &.error-input {
        @apply border border-axa-red-error;
    }
}

.btn {
    @apply text-white text-[14px] uppercase tracking-[1px] p-[12px_10px_10px_10px] xl:p-[12px_15px_10px_18px] border-transparent transition-[0.4s];
}

.btn {
    &.btn--dark-blue {
        @apply bg-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-blue-100 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
    }

    &.btn--green {
        @apply bg-axa-green-500 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-green-600 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
    }

    &.btn--white-outline {
        @apply text-white bg-transparent border border-white relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-white before:duration-300 before:ease-out hover:text-axa-blue-300 hover:before:h-40 hover:before:w-full hover:before:opacity-100;
    }

    &.btn--dark-blue-outline {
        @apply text-axa-blue-400 bg-white border border-axa-blue-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-blue-300 before:duration-300 before:ease-out hover:text-white hover:before:h-40 hover:before:w-full hover:before:opacity-100;
    }

    &.btn--sienna {
        @apply bg-axa-sienna-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-sienna-200 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
    }
    
    &.btn--disabled {
        @apply pointer-events-none cursor-not-allowed text-[#999999] bg-axa-grey-400 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-grey-500 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
    }

    &.btn--grey {
        @apply text-axa-grey-800 bg-axa-grey-300 relative overflow-hidden transition-all duration-300 before:absolute before:bottom-0 before:left-0 before:right-0 before:top-0 before:m-auto before:h-0 before:w-0 before:bg-axa-grey-400 before:duration-300 before:ease-out hover:before:h-40 hover:before:w-full hover:before:opacity-80;
    }
}

.btn-date {
    @apply text-white uppercase text-[12px] p-[8px_16px];
    &.btn-apply {
        @apply bg-axa-blue-400;
    }
    &.btn-cancel {
        @apply text-axa-blue-400;
    }
}

.radio-custom-wrapper {
    & span {
        @apply text-[14px] md:text-[16px];
    }
}

.radio-custom-wrapper input {
    @apply p-0 w-[initial] h-[initial] mb-0 hidden cursor-pointer;
}

.radio-custom-wrapper label:before {
    content: "";
    appearance: none;
    background-color: #fff;
    border: 1px solid #cccccc;
    border-radius: 50%;
    padding: 9px;
    display: inline-block;
    position: relative;
    vertical-align: middle;
    cursor: pointer;
    margin-right: 12px;
}

.radio-custom-wrapper input:checked + label:before {
    background-color: #fff;
    border: 1px solid #00008f;
}

.radio-custom-wrapper input:checked + label:after {
    content: "";
    display: block;
    background-color: #00008f;
    position: absolute;
    border-radius: 50%;
    top: 5px;
    left: 4px;
    width: 12px;
    height: 12px;
    transform: rotate(45deg);
}

.radio-custom-wrapper input:checked + label:after {
    top: 7px;
}

.accordion {
    & .collapsing {
        height: 0;
        transition: height 0.35s ease;
        overflow: hidden;
    }
    & .collapse:not(.show) {
        display: none;
    }
    & .collapse {
        visibility: visible;
    }
}

.accordion-button {
    @apply bg-white text-axa-grey-800 text-[14px] tracking-[1px] w-full text-left px-10 py-6 relative uppercase font-semibold border-b border-[#CCCCCC];
    transition: 0.4s all;
    overflow-anchor: none;
    cursor: pointer;
    & .fa-chevron-down {
        transition: transform 0.4s ease-in-out;
        backface-visibility: hidden;
        transform: rotate(0deg);
    }
    &[aria-expanded="true"] {
        @apply bg-[#FAFAFA] text-axa-blue-400 border-transparent;
        & .fa-chevron-down {
            transform: rotate(180deg);
        }
    }
}

.accordion-body {
    @apply bg-white p-[35px_40px] border-t border-b border-axa-sienna-400 transition-all;
    & p {
        @apply text-[15px];
    }
    & ul {
        & li {
            @apply border-t border-axa-grey-300 pl-[25px];
        }
    }
}

footer h5 {
    @apply font-semibold text-white text-[16px] uppercase tracking-[1px] mb-[15px];
}

.footer__inner {
    @apply bg-axa-ocean-200 pt-45px;
}

.footer-wrapper__grid {
    @apply lg:grid lg:grid-cols-[2fr_1fr];
}

.footer-wrapper__sitemap--inner {
    @apply lg:flex lg:justify-evenly;
    & .col-sitemap ul li {
        @apply text-white;
    }
    & .col-sitemap ul li a {
        @apply text-white;
    }
    & .col-sitemap h5 {
        @apply text-white;
    }
    & .col-sitemap ul li a {
        @apply text-[16px] transition duration-300 ease-in-out hover:underline;
    }
    & .col-sitemap {
        @apply mb-2 lg:mb-0;
    }
    & .col-sitemap:nth-child(2) ul {
        @apply columns-2 lg:columns-2 mb-4 lg:mb-0;
    }
}

.footer-wrapper__contact {
    & .phone-contact {
        & a {
            @apply hover:underline;
        }
    }
}

.social-media ul {
    @apply flex gap-7;
}

.social-media ul li a {
    @apply text-white text-[20px] transition duration-300 ease-in-out hover:text-axa-blue-400;
}

.social-media ul li:nth-child(4) { 
    & .group {
        @apply transition duration-300 ease-in-out fill-white;
        &:hover {
            @apply fill-axa-blue-400;
        }
    }
}

.copyright {
    @apply border-t border-axa-ocean-100 mt-45px py-[15px];
    & .copyright__wrapper {
        @apply md:container md:mx-auto;
        & a {
            @apply underline hover:no-underline;
        }
    }
}

