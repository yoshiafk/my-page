    @apply cursor-pointer;
}

.order-list-decimal {
    @apply list-decimal;
}

/* SKELETON */
.skeleton {
    -webkit-animation: skeleton-loading 1s linear infinite alternate;
    animation: skeleton-loading 1s linear infinite alternate;
}

@-webkit-keyframes skeleton-loading {
    0% {
        background-color: #c2cfd6;
    }
    100% {
        background-color: #f0f3f5;
    }
}

@keyframes skeleton-loading {
    0% {
        background-color: #c2cfd6;
    }
    100% {
        background-color: #f0f3f5;
    }
}

.skeleton-text {
    width: 100%;
    height: 0.7rem;
    margin-bottom: 0.5rem;
    border-radius: 0.25rem;
    display: inline-block;
    margin: 0;
}

.skeleton-text-half {
    width: 50%;
    height: 0.7rem;
    margin-bottom: 0.5rem;
    border-radius: 0.25rem;
    display: inline-block;
    margin: 0;
}

.skeleton-text-right {
    width: 100px;
    height: 0.7rem;
    margin-bottom: 0.5rem;
    border-radius: 0.25rem;
    display: inline-block;
    margin: 0;
    text-align: right;
}

.skeleton-text__body {
    width: 75%;
}

.skeleton-footer {
    width: 30%;
}

.modal-loading {
    @apply h-full overflow-x-hidden overflow-y-auto;
    padding: 1rem !important;
    /* overflow: hidden !important; */
}

.modal-loading {
    @apply fixed outline-none z-[1055] top-2/4 left-2/4 translate-y-[-50%] translate-x-[-50%];
    & .modal-loading-dialog {
        @apply mx-auto relative min-[576px]:m-auto;
    }
    & .modal-loading-content {
        @apply bg-white w-full h-full border-none shadow-none rounded-none;
    }
    &.fade {
        & .modal-agency-dialog {
          transition: transform 0.3s ease-out;
          transform: translate(0, -50px);
        }
    }
}

.fade {
    transition: opacity 0.15s linear;
}
  
.fade:not(.show) {
    opacity: 0;
}

.modal-backdrop {
    @apply fixed w-[100vw] h-full bg-black/40 top-0 left-0 z-[1050] backdrop-blur;
    &.fade {
      @apply opacity-0;
    }
    &.show {
      @apply opacity-[1];
    }
}

.modal-loading-dialog-centered {
    display: flex;
    align-items: center;
    min-height: calc(100% - 0px * 2);
}

.modal-dialog-iframe {
    overflow-y: scroll;
    max-height: 1020px;
}

.payment-method {
    @apply pt-4 md:pt-[33px] xl:pt-[20px] md:pb-[33px] xl:pb-[30px];
    & .payment-method__succsesful {
        @apply bg-white min-h-[468px] text-center mt-4 lg:mt-0 p-[100px_20px_80px_20px] border border-axa-grey-300 mx-[15px] lg:mx-0;
        & h1 {
            @apply text-[26px] lg:text-[32px] font-publico font-bold text-axa-grey-800 mb-[10px];
        }
        & p {
            @apply text-[16px] text-axa-grey-800 mb-[20px];
        }
    }
}
  
@media (min-width: 600px) {
    .modal-dialog-iframe {
      margin-top: 70px;
    }
}
  
@media (max-width: 767px) {
    .modal-dialog-iframe {
      margin-top: 70px;
      max-height: 1710px;
    }
}
  
@media (min-width: 768px) and (max-width: 1023px) {
    .modal-dialog-iframe {
      max-height: none;
    }
}
  
@media (min-width: 1024px) {
    .modal-dialog-iframe {
      margin-top: 0;
    }
}