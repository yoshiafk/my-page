<?xml version="1.0"?>
 <!DOCTYPE routes PUBLIC "-//Liferay//DTD Friendly URL Routes 7.0.0//EN" "http://www.liferay.com/dtd/liferay-friendly-url-routes_7_0_0.dtd">

 <routes>
	<route>
		<pattern>/configuration</pattern>
		<implicit-parameter name="mvcPath">/product/property/configuration.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/occupancy</pattern>
		<implicit-parameter name="mvcPath">/product/property/occupancy/list.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/occupancy/edit</pattern>
		<implicit-parameter name="mvcPath">/product/property/occupancy/edit.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>	
	<route>
		<pattern>/email-template</pattern>
		<implicit-parameter name="mvcPath">/product/property/email_template.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>			
 </routes>