                    </td>
                    <td class="pl-10px">${leads.address}</td>
                </tr>
                <tr>
                    <td class="agency__bg-f0f0f0">
                        <span style="text-decoration: underline;">Tujuan</span><br />
                        <span class="title_table_penawaran">Destination</span>
                    </td>
                    <td class="pl-10px">Australia</td>
                </tr>
                <tr>
                    <td class="agency__bg-f0f0f0">
