                        <span style="text-decoration: underline;">Paket Manfaat</span><br />
                        <span class="title_table_penawaran">Benefit Package</span>
                    </td>
                    <td class="pl-10px">Platinum</td>
                </tr>
                <tr>
                    <td class="agency__bg-f0f0f0">
                        <span style="text-decoration: underline;">Periode Asuransi</span><br />
                        <span class="title_table_penawaran">Period of Insurance</span>
