            <table class="table_coverage">
                <thead>
                    <tr class="agency__bg-c5b8b8">
                        <th class="table_coverage_col">No.</th>
                        <th class="table_coverage_col">
                            <span style="text-decoration: underline;">Nama</span><br />
                            <span class="title_table_penawaran">Name</span>
                        </th>
                        <th class="table_coverage_col">
                            <span style="text-decoration: underline;">Tanggal Lahir</span><br />
                            <span class="title_table_penawaran">Date of Birth</span>
                        </th>
                        <th class="table_coverage_col">
                            <span style="text-decoration: underline;">No KTP / Passpor / KITAS</span><br />
