                    <td class="pl-10px">17 August 2024 to 29 August 2024 (both date inclusive)</td>
                </tr>
                <tr>
                    <td class="agency__bg-f0f0f0">
                        <span style="text-decoration: underline;">Jumlah Tertanggung Dewasa</span><br />
                        <span class="title_table_penawaran">Amount of Adult Insured</span>
                    </td>
                    <td class="pl-10px">2 Orang / Person</td>
                </tr>
                <tr>
                    <td class="agency__bg-f0f0f0">
                        <span style="text-decoration: underline;">Jumlah Tertanggung Anak</span><br />
                        <span class="title_table_penawaran">Amount of Child Insured</span>
