            style="font-size: 20px; font-family: 'Trebuchet MS'; letter-spacing: 1.3pt; color: #333333; background-color: #bdbdbd;">
            Ringkasan Manfaat /
            <i>Benefit Summary</i>
        </div>

        <div class="jaminan_utama mt-5level">
            <span class="ml-10px agency__font-semibold">JAMINAN UTAMA / <i>MAIN BENEFIT</i></span>

            <table class="table_benefit">
                <thead>
                    <tr class="agency__bg-c5b8b8">
                        <th class="table_coverage_col">No.</th>
                        <th class="table_coverage_col">
                            <span style="text-decoration: normal;">Jaminan / <i>Coverage</i></span>
                        </th>
                        <th class="table_coverage_col">
                            <span style="text-decoration: normal;">Uang Pertanggungan / <i>Sum Insured</i> (IDR)</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Baris 1 -->
                    <tr>
                        <!-- Kolom 1 (Nomor) -->
                        <td rowspan="3" class="table_coverage_col_td align-top agency__bg-f0f0f0">1.</td>
                        <td colspan="2" class="table_coverage_col_td agency__bg-f0f0f0">Biaya Pengobatan,
                            Gigi dan
                            Lainnya / <i>Medical, Dental and Other Expenses</i></td>
                    </tr>
                    <tr>
                        <td class="table_coverage_col_td agency__bg-f0f0f0">
