<?xml version="1.0"?>
 <!DOCTYPE routes PUBLIC "-//Liferay//DTD Friendly URL Routes 7.0.0//EN" "http://www.liferay.com/dtd/liferay-friendly-url-routes_7_0_0.dtd">
<routes>	
	<route>
		<pattern>/sales-tools</pattern>
		<implicit-parameter name="mvcPath">/salestools/master/salestools/list.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/sales-tools/edit</pattern>
		<implicit-parameter name="mvcPath">/salestools/master/salestools/edit.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/category</pattern>
		<implicit-parameter name="mvcPath">/salestools/master/category/list.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/category/edit</pattern>
		<implicit-parameter name="mvcPath">/salestools/master/category/edit.jsp</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
	<route>
		<pattern>/{eventId}-{title}</pattern>
		<implicit-parameter name="mvcPath">/dashboard/calendar/detail.jsp</implicit-parameter>
	</route>
	<route>
		<pattern>/{prettyUrl}</pattern>
		<implicit-parameter name="mvcPath">/pages/profile.jsp</implicit-parameter>
	</route>		
</routes>