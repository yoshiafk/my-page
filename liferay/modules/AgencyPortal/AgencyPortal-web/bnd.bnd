Bundle-Name: AgencyPortal-web
Bundle-SymbolicName: com.mypage.agencyportal
Bundle-Version: 1.0.0
Export-Package: com.mypage.agencyportal.constants
-privatepackage: \
	com.itextpdf.*,\
	com.fasterxml.jackson.*,\
	org.slf4j.*,\
	freemarker.*
Import-Package: \
	!com.itextpdf.bouncycastle,\
	!com.itextpdf.bouncycastlefips,\
	!com.sun.org.apache.xml.internal.utils,\
	!com.sun.org.apache.xpath.internal,\
	!com.sun.org.apache.xpath.internal.objects,\
	!org.apache.log,\
	!org.apache.logging.log4j,\
	!org.apache.logging.log4j.core,\
	!org.mozilla.javascript,\
	!org.python.core,\
	!org.python.util,\
	!org.zeroturnaround.javarebel,\
	org.apache.commons.fileupload.*,\
	*