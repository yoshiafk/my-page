# Database
DATABASE_URL=postgresql://admin:password@localhost:5432/insurance_platform

# OneAccount OIDC
OIDC_ISSUER_URL=https://oneaccount.axa.co.id
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Liferay Bridge
LIFERAY_BASE_URL=https://mypage.axa.co.id
LIFERAY_API_USER=your-liferay-api-user
LIFERAY_API_PASSWORD=your-liferay-api-password

# API Server
API_PORT=3001

# Admin Portal URL (for CORS and OIDC redirect)
ADMIN_ORIGIN=http://localhost:5173
